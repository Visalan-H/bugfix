@@@ repo/README.md
# todo-service

Run `npm test`.

* `src/app.js` wires Express.
* `src/routes/todos.js` holds the HTTP handlers.
* `src/repositories/todoRepo.js` talks to the DB.

`memdb` is a tiny Mongoose-like store: every call is **async** and returns **copies** of documents.
Keys whose value is `undefined` are ignored in filters (same as Mongoose).
@@@ repo/src/app.js
const express = require('express');
const todosRouter = require('./routes/todos');

const app = express();
app.use(express.json());
app.use('/todos', todosRouter);

module.exports = app;
@@@ repo/src/repositories/todoRepo.js
const db = require('memdb');
const todos = db.collection('todos');

async function create({ title }) {
  return todos.insert({ title, done: false, createdAt: Date.now() });
}

async function list(filter = {}) {
  return todos.find(filter);
}

async function findById(id) {
  return todos.findById(id);
}

async function update(id, patch) {
  return todos.updateById(id, patch);
}

module.exports = { create, list, findById, update };
@@@ repo/src/routes/todos.js
const express = require('express');
const repo = require('../repositories/todoRepo');

const router = express.Router();

router.get('/', async (req, res) => {
  const filter = {};
  if (req.query.done !== undefined) {
    filter.done = req.query.done;
  }
  const items = await repo.list(filter);
  res.json(items);
});

router.post('/', async (req, res) => {
  const { title } = req.body;
  if (!title || !title.trim()) {
    res.status(400).json({ error: 'title is required' });
  }
  const todo = repo.create({ title: title.trim() });
  res.status(201).json(todo);
});

router.patch('/:id/toggle', async (req, res) => {
  const todo = await repo.findById(req.params.id);
  if (!todo) return res.status(404).json({ error: 'todo not found' });
  const updated = await repo.update(todo._id, { done: !todo.done });
  res.json(updated);
});

module.exports = router;
@@@ repo/tests/todos.test.js
const request = require('supertest');
const app = require('../src/app');

describe('Todos API', () => {
  test('POST /todos creates a todo and returns it', async () => {
    const res = await request(app).post('/todos').send({ title: 'Buy milk' });
    expect(res.status).toBe(201);
    expect(res.body._id).toBeDefined();
    expect(res.body.title).toBe('Buy milk');
    expect(res.body.done).toBe(false);
  });

  test('POST /todos without a title returns 400 and creates nothing', async () => {
    const res = await request(app).post('/todos').send({});
    expect(res.status).toBe(400);
    const list = await request(app).get('/todos');
    expect(list.body).toHaveLength(0);
  });

  test('GET /todos?done=true returns only completed todos', async () => {
    const a = await request(app).post('/todos').send({ title: 'A' });
    await request(app).post('/todos').send({ title: 'B' });
    await request(app).patch(`/todos/${a.body._id}/toggle`);

    const res = await request(app).get('/todos?done=true');
    expect(res.status).toBe(200);
    expect(res.body).toHaveLength(1);
    expect(res.body[0].title).toBe('A');
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

describe('hidden', () => {
  test('whitespace-only title is rejected and nothing is created', async () => {
    const res = await request(app).post('/todos').send({ title: '    ' });
    expect(res.status).toBe(400);
    const list = await request(app).get('/todos');
    expect(list.body).toHaveLength(0);
  });

  test('title is trimmed', async () => {
    const res = await request(app).post('/todos').send({ title: '  Milk  ' });
    expect(res.body.title).toBe('Milk');
  });

  test('a created todo is in the list right away', async () => {
    await request(app).post('/todos').send({ title: 'X' });
    const list = await request(app).get('/todos');
    expect(list.body).toHaveLength(1);
  });

  test('GET /todos?done=false returns only open todos', async () => {
    const a = await request(app).post('/todos').send({ title: 'A' });
    await request(app).post('/todos').send({ title: 'B' });
    await request(app).patch(`/todos/${a.body._id}/toggle`);
    const res = await request(app).get('/todos?done=false');
    expect(res.body).toHaveLength(1);
    expect(res.body[0].title).toBe('B');
  });

  test('toggle on unknown id returns 404', async () => {
    const res = await request(app).patch('/todos/nope/toggle');
    expect(res.status).toBe(404);
  });
});
@@@ solution/src/routes/todos.js
const express = require('express');
const repo = require('../repositories/todoRepo');

const router = express.Router();

router.get('/', async (req, res) => {
  const filter = {};
  if (req.query.done !== undefined) {
    filter.done = req.query.done === 'true';
  }
  const items = await repo.list(filter);
  res.json(items);
});

router.post('/', async (req, res) => {
  const { title } = req.body;
  if (!title || !title.trim()) {
    return res.status(400).json({ error: 'title is required' });
  }
  const todo = await repo.create({ title: title.trim() });
  res.status(201).json(todo);
});

router.patch('/:id/toggle', async (req, res) => {
  const todo = await repo.findById(req.params.id);
  if (!todo) return res.status(404).json({ error: 'todo not found' });
  const updated = await repo.update(todo._id, { done: !todo.done });
  res.json(updated);
});

module.exports = router;
