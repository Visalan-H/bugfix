@@@ ticket.md
# DRIVE-3: Quota is wrong

Quota: **1024 KB per user**. Header `x-user-id`.

| Method | Path | Behaviour |
|---|---|---|
| `PUT` | `/files/:name { sizeKb }` | Create or **replace** a file. **201**. Would exceed quota → **413** (nothing changes). Exactly 1024 is OK |
| `DELETE` | `/files/:name` | **204**, frees its space. Unknown → **404** |
| `GET` | `/usage` | `{ usedKb, quotaKb }` |
@@@ repo/package.json
{ "name": "drive", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/storage.js
const db = require('memdb');
const files = db.collection('files');
const usage = db.collection('usage');

const QUOTA_KB = 1024;
class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }

async function getUsage(userId) {
  return (await usage.findById(userId)) || usage.insert({ _id: userId, usedKb: 0 });
}

async function put(userId, name, sizeKb) {
  if (!Number.isInteger(sizeKb) || sizeKb <= 0) throw new HttpError(400, 'sizeKb must be a positive integer');
  const u = await getUsage(userId);
  if (u.usedKb > QUOTA_KB) throw new HttpError(413, 'quota exceeded');

  const existing = await files.findOne({ userId, name });
  if (existing) await files.updateById(existing._id, { sizeKb });
  else await files.insert({ userId, name, sizeKb });
  await usage.findOneAndUpdate({ _id: userId }, { $inc: { usedKb: sizeKb } });
}

async function remove(userId, name) {
  const file = await files.findOne({ userId, name });
  if (!file) throw new HttpError(404, 'not found');
  await files.deleteById(file._id);
  const u = await getUsage(userId);
  u.usedKb -= file.sizeKb;
}

async function report(userId) {
  const u = await getUsage(userId);
  return { usedKb: u.usedKb, quotaKb: QUOTA_KB };
}

module.exports = { put, remove, report };
@@@ repo/src/app.js
const express = require('express');
const s = require('./storage');

const app = express();
app.use(express.json());
app.put('/files/:name', async (req, res) => {
  await s.put(req.get('x-user-id'), req.params.name, req.body.sizeKb);
  res.status(201).json(await s.report(req.get('x-user-id')));
});
app.delete('/files/:name', async (req, res) => {
  await s.remove(req.get('x-user-id'), req.params.name);
  res.status(204).end();
});
app.get('/usage', async (req, res) => res.json(await s.report(req.get('x-user-id'))));
app.use((err, req, res, next) => res.status(err.status || 500).json({ error: err.message }));

module.exports = app;
@@@ repo/tests/quota.test.js
const request = require('supertest');
const app = require('../src/app');

const put = (name, sizeKb) => request(app).put(`/files/${name}`).set('x-user-id', 'u1').send({ sizeKb });
const usage = async () => (await request(app).get('/usage').set('x-user-id', 'u1')).body.usedKb;

describe('Quota', () => {
  test('upload over quota → 413', async () => {
    await put('a.mp4', 1000);
    expect((await put('b.png', 100)).status).toBe(413);
    expect(await usage()).toBe(1000);
  });
  test('delete frees space', async () => {
    await put('a.mp4', 600);
    await request(app).delete('/files/a.mp4').set('x-user-id', 'u1');
    expect(await usage()).toBe(0);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const put = (name, sizeKb, u = 'u1') => request(app).put(`/files/${name}`).set('x-user-id', u).send({ sizeKb });
const usage = async (u = 'u1') => (await request(app).get('/usage').set('x-user-id', u)).body.usedKb;

describe('hidden', () => {
  test('replacing a file adjusts by the difference', async () => {
    await put('doc.pdf', 300);
    await put('doc.pdf', 500);
    expect(await usage()).toBe(500);
  });
  test('exactly filling the quota is OK', async () => {
    await put('a', 1000);
    expect((await put('b', 24)).status).toBe(201);
  });
  test('replacing with a smaller file when full', async () => {
    await put('a', 1024);
    expect((await put('a', 10)).status).toBe(201);
    expect(await usage()).toBe(10);
  });
  test('users have separate quotas', async () => {
    await put('a', 1024, 'u1');
    expect((await put('a', 1024, 'u2')).status).toBe(201);
  });
  test('delete unknown → 404', async () => {
    expect((await request(app).delete('/files/nope').set('x-user-id', 'u1')).status).toBe(404);
  });
});
@@@ solution/src/storage.js
const db = require('memdb');
const files = db.collection('files');
const usage = db.collection('usage');

const QUOTA_KB = 1024;
class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }

async function getUsage(userId) {
  return (await usage.findById(userId)) || usage.insert({ _id: userId, usedKb: 0 });
}

async function put(userId, name, sizeKb) {
  if (!Number.isInteger(sizeKb) || sizeKb <= 0) throw new HttpError(400, 'sizeKb must be a positive integer');
  const u = await getUsage(userId);
  const existing = await files.findOne({ userId, name });
  const delta = sizeKb - (existing ? existing.sizeKb : 0);
  if (u.usedKb + delta > QUOTA_KB) throw new HttpError(413, 'quota exceeded');

  if (existing) await files.updateById(existing._id, { sizeKb });
  else await files.insert({ userId, name, sizeKb });
  await usage.findOneAndUpdate({ _id: userId }, { $inc: { usedKb: delta } });
}

async function remove(userId, name) {
  const file = await files.findOne({ userId, name });
  if (!file) throw new HttpError(404, 'not found');
  await files.deleteById(file._id);
  await usage.findOneAndUpdate({ _id: userId }, { $inc: { usedKb: -file.sizeKb } });
}

async function report(userId) {
  const u = await getUsage(userId);
  return { usedKb: u.usedKb, quotaKb: QUOTA_KB };
}

module.exports = { put, remove, report };
