@@@ repo/tests/search.test.js
const request = require('supertest');
const app = require('../src/app');

const search = (qs) => request(app).get(`/movies/search?${qs}`);
const titles = (res) => res.body.results.map((m) => m.title);

describe('GET /movies/search', () => {
  test('rule 1+2: director search, case-insensitive', async () => {
    const res = await search('q=nolan&field=director');
    expect(res.status).toBe(200);
    expect(res.body.count).toBe(4);
  });

  test('rule 1: partial title match ignores case', async () => {
    const res = await search('q=KNIGHT');
    expect(titles(res).sort()).toEqual(['Knight and Day', 'The Dark Knight']);
  });

  test('rule 4: rating desc, then title asc', async () => {
    const res = await search('q=sci-fi&field=genre');
    expect(titles(res)).toEqual(['Inception', 'Interstellar', 'Blade Runner 2049', 'Dune', 'Arrival']);
  });

  test('rule 3: whitespace-only q returns everything', async () => {
    const res = await search('q=%20%20%20');
    expect(res.body.count).toBe(10);
  });

  test('rule 5: minRating is inclusive', async () => {
    const res = await search('minRating=8.0');
    expect(titles(res)).toEqual(['The Dark Knight', 'Inception', 'Interstellar', 'Blade Runner 2049', 'Dune']);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const search = (qs) => request(app).get(`/movies/search?${qs}`);
const titles = (res) => res.body.results.map((m) => m.title);

describe('hidden', () => {
  test('unknown field → 400', async () => {
    const res = await search('q=x&field=year');
    expect(res.status).toBe(400);
  });

  test('non-numeric minRating → 400', async () => {
    const res = await search('minRating=abc');
    expect(res.status).toBe(400);
  });

  test('minRating out of range → 400', async () => {
    const res = await search('minRating=11');
    expect(res.status).toBe(400);
  });

  test('regex special characters are treated literally', async () => {
    const res = await search('q=(500');
    expect(res.status).toBe(200);
    expect(titles(res)).toEqual(['(500) Days of Summer']);
  });

  test('padded q is trimmed before matching', async () => {
    const res = await search('q=%20dune%20');
    expect(titles(res)).toEqual(['Dune']);
  });

  test('genre + minRating combined, sorted', async () => {
    const res = await search('q=action&field=genre&minRating=6.9');
    expect(titles(res)).toEqual(['The Dark Knight', 'The Amazing Spider-Man']);
  });

  test('no match → empty list, count 0', async () => {
    const res = await search('q=zzz');
    expect(res.body).toEqual({ count: 0, results: [] });
  });
});
@@@ solution/src/controllers/movieController.js
const searchService = require('../services/searchService');

const ALLOWED_FIELDS = ['title', 'director', 'genre'];

exports.search = async (req, res) => {
  const field = req.query.field || 'title';
  if (!ALLOWED_FIELDS.includes(field)) {
    return res.status(400).json({ error: `field must be one of ${ALLOWED_FIELDS.join(', ')}` });
  }

  let minRating;
  if (req.query.minRating !== undefined) {
    minRating = Number(req.query.minRating);
    if (Number.isNaN(minRating) || minRating < 0 || minRating > 10) {
      return res.status(400).json({ error: 'minRating must be between 0 and 10' });
    }
  }

  const results = await searchService.search({ q: req.query.q, field, minRating });
  res.json({ count: results.length, results });
};
@@@ solution/src/services/searchService.js
const movieRepo = require('../repositories/movieRepo');
const { byRatingThenTitle } = require('../utils/sort');

async function search({ q, field, minRating }) {
  const term = (q || '').trim();
  let movies;
  if (!term) {
    movies = await movieRepo.findAll({ minRating });
  } else {
    movies = await movieRepo.searchByField(field, term, { minRating });
  }
  return movies.sort(byRatingThenTitle);
}

module.exports = { search };
@@@ solution/src/repositories/movieRepo.js
const db = require('memdb');
const SEED = require('../data/movies');

const movies = db.collection('movies');
const ready = Promise.all(SEED.map((m) => movies.insert(m)));

const escapeRegex = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

function ratingFilter(minRating) {
  return minRating !== undefined ? { rating: { $gte: minRating } } : {};
}

async function findAll({ minRating } = {}) {
  await ready;
  return movies.find(ratingFilter(minRating));
}

async function searchByField(field, q, { minRating } = {}) {
  await ready;
  const filter = { ...ratingFilter(minRating), [field]: { $regex: escapeRegex(q), $options: 'i' } };
  return movies.find(filter);
}

module.exports = { findAll, searchByField };
@@@ solution/src/utils/sort.js
// Highest rating first; ties broken alphabetically by title.
const byRatingThenTitle = (a, b) => b.rating - a.rating || a.title.localeCompare(b.title);

module.exports = { byRatingThenTitle };
