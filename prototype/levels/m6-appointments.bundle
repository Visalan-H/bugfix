@@@ ticket.md
# CLINIC-12: Booking says 'slot taken' when it isn't

Times are **minutes since midnight** (600 = 10:00). Intervals are `[start, end)`: an appointment ending at 630 and one starting at 630 don't clash.

| Method | Path | Behaviour |
|---|---|---|
| `POST` | `/appointments { doctorId, start, end }` | **201**. Clash with the **same doctor's** booked appointment → **409**. Bad interval → **400** |
| `POST` | `/appointments/:id/cancel` | **200**, frees the slot |
@@@ repo/package.json
{ "name": "clinic", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/app.js
const express = require('express');
const booking = require('./booking');

const app = express();
app.use(express.json());

app.post('/appointments', async (req, res) => {
  res.status(201).json(await booking.book(req.body));
});
app.post('/appointments/:id/cancel', async (req, res) => {
  res.json(await booking.cancel(req.params.id));
});
app.use((err, req, res, next) => res.status(err.status || 500).json({ error: err.message }));

module.exports = app;
@@@ repo/src/booking.js
const db = require('memdb');
const appts = db.collection('appointments');

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }

const overlaps = (a, b) => a.start <= b.end && b.start <= a.end;

async function book({ doctorId, start, end }) {
  if (!doctorId) throw new HttpError(400, 'doctorId is required');
  const existing = await appts.find({});
  if (existing.some((e) => overlaps(e, { start, end }))) throw new HttpError(409, 'slot taken');
  return appts.insert({ doctorId, start, end, status: 'booked' });
}

async function cancel(id) {
  const a = await appts.findById(id);
  if (!a) throw new HttpError(404, 'not found');
  return appts.updateById(id, { status: 'cancelled' });
}

module.exports = { book, cancel };
@@@ repo/tests/booking.test.js
const request = require('supertest');
const app = require('../src/app');

const book = (doctorId, start, end) => request(app).post('/appointments').send({ doctorId, start, end });

describe('Booking', () => {
  test('back-to-back slots are fine', async () => {
    expect((await book('iyer', 600, 630)).status).toBe(201);
    expect((await book('iyer', 630, 660)).status).toBe(201);
  });
  test('real overlap → 409', async () => {
    await book('iyer', 600, 660);
    expect((await book('iyer', 630, 690)).status).toBe(409);
  });
  test('different doctors don\'t clash', async () => {
    await book('iyer', 600, 630);
    expect((await book('rao', 600, 630)).status).toBe(201);
  });
  test('cancelled slot can be rebooked', async () => {
    const a = await book('iyer', 600, 630);
    await request(app).post(`/appointments/${a.body._id}/cancel`);
    expect((await book('iyer', 600, 630)).status).toBe(201);
  });
});
