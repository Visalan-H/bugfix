@@@ repo/src/reviews.js
const db = require('memdb');
const reviews = db.collection('reviews');

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }

async function add(productId, userId, rating) {
  if (typeof rating !== 'number' || rating < 1 || rating > 5) throw new HttpError(400, 'rating must be 1-5');
  return reviews.insert({ productId, userId, rating, deleted: false });
}

async function remove(id, userId) {
  const r = await reviews.findById(id);
  if (!r || r.deleted) throw new HttpError(404, 'not found');
  if (r.userId !== userId) throw new HttpError(403, 'not yours');
  await reviews.updateById(id, { deleted: true });
}

async function rating(productId) {
  const all = await reviews.find({ productId });
  const sum = all.filter((r) => !r.deleted).reduce((s, r) => s + r.rating, 0);
  const avg = sum / all.length;
  return { avgRating: avg.toFixed(1), reviewCount: all.filter((r) => !r.deleted).length };
}

module.exports = { add, remove, rating };
@@@ repo/src/app.js
const express = require('express');
const svc = require('./reviews');

const app = express();
app.use(express.json());
app.post('/products/:id/reviews', async (req, res) => {
  res.status(201).json(await svc.add(req.params.id, req.get('x-user-id'), req.body.rating));
});
app.delete('/reviews/:id', async (req, res) => {
  await svc.remove(req.params.id, req.get('x-user-id'));
  res.status(204).end();
});
app.get('/products/:id/rating', async (req, res) => res.json(await svc.rating(req.params.id)));
app.use((err, req, res, next) => res.status(err.status || 500).json({ error: err.message }));

module.exports = app;
@@@ repo/tests/reviews.test.js
const request = require('supertest');
const app = require('../src/app');

const review = (user, rating, p = 'p1') => request(app).post(`/products/${p}/reviews`).set('x-user-id', user).send({ rating });
const rating = (p = 'p1') => request(app).get(`/products/${p}/rating`);

describe('Reviews', () => {
  test('average is a 1-decimal number', async () => {
    await review('a', 5); await review('b', 4); await review('c', 4);
    expect((await rating()).body).toEqual({ avgRating: 4.3, reviewCount: 3 });
  });
  test('one review per user per product', async () => {
    await review('a', 5);
    expect((await review('a', 1)).status).toBe(409);
  });
  test('deleted reviews don\'t count', async () => {
    await review('a', 5); await review('b', 4);
    const r = await review('c', 3);
    await request(app).delete(`/reviews/${r.body._id}`).set('x-user-id', 'c');
    expect((await rating()).body).toEqual({ avgRating: 4.5, reviewCount: 2 });
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const review = (user, rating, p = 'p1') => request(app).post(`/products/${p}/reviews`).set('x-user-id', user).send({ rating });

describe('hidden', () => {
  test('3.5 → 400', async () => { expect((await review('a', 3.5)).status).toBe(400); });
  test('no reviews → 0', async () => {
    expect((await request(app).get('/products/p9/rating')).body).toEqual({ avgRating: 0, reviewCount: 0 });
  });
  test('can review again after deleting', async () => {
    const r = await review('a', 2);
    await request(app).delete(`/reviews/${r.body._id}`).set('x-user-id', 'a');
    expect((await review('a', 5)).status).toBe(201);
  });
  test('same user, different products is fine', async () => {
    await review('a', 5, 'p1');
    expect((await review('a', 5, 'p2')).status).toBe(201);
  });
  test('cannot delete someone else\'s review', async () => {
    const r = await review('a', 5);
    expect((await request(app).delete(`/reviews/${r.body._id}`).set('x-user-id', 'b')).status).toBe(403);
  });
});
@@@ solution/src/reviews.js
const db = require('memdb');
const reviews = db.collection('reviews');

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }

async function add(productId, userId, rating) {
  if (!Number.isInteger(rating) || rating < 1 || rating > 5) throw new HttpError(400, 'rating must be an integer 1-5');
  if (await reviews.findOne({ productId, userId, deleted: false })) throw new HttpError(409, 'already reviewed');
  return reviews.insert({ productId, userId, rating, deleted: false });
}

async function remove(id, userId) {
  const r = await reviews.findById(id);
  if (!r || r.deleted) throw new HttpError(404, 'not found');
  if (r.userId !== userId) throw new HttpError(403, 'not yours');
  await reviews.updateById(id, { deleted: true });
}

async function rating(productId) {
  const active = (await reviews.find({ productId })).filter((r) => !r.deleted);
  if (!active.length) return { avgRating: 0, reviewCount: 0 };
  const avg = active.reduce((s, r) => s + r.rating, 0) / active.length;
  return { avgRating: Math.round(avg * 10) / 10, reviewCount: active.length };
}

module.exports = { add, remove, rating };
