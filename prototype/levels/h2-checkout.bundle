exports.findById = (id) => orders.findById(id);
@@@ repo/tests/orders.test.js
const request = require('supertest');
const app = require('../src/app');

const order = (items, key) => {
  const r = request(app).post('/orders').set('x-user-id', 'u1');
  if (key) r.set('Idempotency-Key', key);
  return r.send({ items });
};
const stock = async (id) => (await request(app).get(`/products/${id}`).set('x-user-id', 'u1')).body.stock;

describe('Checkout', () => {
  test('total is rounded to 2 decimals and stock goes down', async () => {
    const res = await order([{ productId: 'p-echo', qty: 1 }, { productId: 'p-cable', qty: 2 }]);
    expect(res.status).toBe(201);
    expect(res.body.total).toBe(69.97);
    expect(await stock('p-echo')).toBe(4);
    expect(await stock('p-cable')).toBe(0);
  });

  test('a failed order does not change any stock', async () => {
    const res = await order([{ productId: 'p-echo', qty: 1 }, { productId: 'p-cable', qty: 5 }]);
    expect(res.status).toBe(409);
    expect(await stock('p-echo')).toBe(5);
    expect(await stock('p-cable')).toBe(2);
  });

  test('two concurrent buyers cannot both get the last Kindle', async () => {
    const [a, b] = await Promise.all([
      order([{ productId: 'p-kindle', qty: 1 }]),
      order([{ productId: 'p-kindle', qty: 1 }]),
    ]);
    expect([a.status, b.status].sort()).toEqual([201, 409]);
    expect(await stock('p-kindle')).toBe(0);
  });

  test('retry with the same Idempotency-Key returns the same order once', async () => {
    const first = await order([{ productId: 'p-echo', qty: 2 }], 'key-123');
    const retry = await order([{ productId: 'p-echo', qty: 2 }], 'key-123');
    expect(first.status).toBe(201);
    expect(retry.status).toBe(200);
    expect(retry.body._id).toBe(first.body._id);
    expect(await stock('p-echo')).toBe(3);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const order = (items, key) => {
  const r = request(app).post('/orders').set('x-user-id', 'u1');
  if (key) r.set('Idempotency-Key', key);
  return r.send({ items });
};
const stock = async (id) => (await request(app).get(`/products/${id}`).set('x-user-id', 'u1')).body.stock;

describe('hidden', () => {
  test('orders without a key are always new orders', async () => {
    const a = await order([{ productId: 'p-echo', qty: 1 }]);
    const b = await order([{ productId: 'p-echo', qty: 1 }]);
    expect(a.status).toBe(201);
    expect(b.status).toBe(201);
    expect(a.body._id).not.toBe(b.body._id);
    expect(await stock('p-echo')).toBe(3);
  });

  test('different keys are different orders', async () => {
    const a = await order([{ productId: 'p-echo', qty: 1 }], 'k1');
    const b = await order([{ productId: 'p-echo', qty: 1 }], 'k2');
    expect(a.body._id).not.toBe(b.body._id);
  });

  test('bad qty on the 2nd line → 400 and no stock change', async () => {
    const res = await order([{ productId: 'p-echo', qty: 1 }, { productId: 'p-cable', qty: 0 }]);
    expect(res.status).toBe(400);
    expect(await stock('p-echo')).toBe(5);
  });

  test('unknown product on the 2nd line → 404 and no stock change', async () => {
    const res = await order([{ productId: 'p-echo', qty: 2 }, { productId: 'nope', qty: 1 }]);
    expect(res.status).toBe(404);
    expect(await stock('p-echo')).toBe(5);
  });

  test('3 concurrent orders of 2 Echo Dots with stock 5 → exactly 2 succeed', async () => {
    const rs = await Promise.all([1, 2, 3].map(() => order([{ productId: 'p-echo', qty: 2 }])));
    expect(rs.filter((r) => r.status === 201)).toHaveLength(2);
    expect(await stock('p-echo')).toBe(1);
  });

  test('empty items → 400', async () => {
    const res = await order([]);
    expect(res.status).toBe(400);
  });
});
@@@ solution/src/controllers/orderController.js
const orderService = require('../services/orderService');
const orderRepo = require('../repositories/orderRepo');

// key -> orderId. (Would be Redis with a TTL in prod.)
const idempotency = new Map();

exports.create = async (req, res) => {
  const key = req.get('Idempotency-Key');
  if (key && idempotency.has(key)) {
    const existing = await orderRepo.findById(idempotency.get(key));
    return res.status(200).json(existing);
  }

  const order = await orderService.placeOrder(req.user.id, req.body.items);
  if (key) idempotency.set(key, order._id);
  res.status(201).json(order);
};
@@@ solution/src/services/orderService.js
const productRepo = require('../repositories/productRepo');
const orderRepo = require('../repositories/orderRepo');
const { ValidationError, NotFoundError, ConflictError } = require('../errors');

async function placeOrder(userId, items) {
  if (!Array.isArray(items) || items.length === 0) {
    throw new ValidationError('items must be a non-empty array');
  }

  // Phase 1: validate everything before touching stock.
  const lines = [];
  for (const { productId, qty } of items) {
    if (!Number.isInteger(qty) || qty <= 0) throw new ValidationError('qty must be a positive integer');
    const product = await productRepo.findById(productId);
    if (!product) throw new NotFoundError('Product');
    lines.push({ productId, name: product.name, price: product.price, qty });
  }

  // Phase 2: reserve atomically; undo on any failure.
  const reserved = [];
  try {
    for (const line of lines) {
      const ok = await productRepo.decrementIfAvailable(line.productId, line.qty);
      if (!ok) throw new ConflictError(`${line.name} is out of stock`);
      reserved.push(line);
    }
  } catch (err) {
    for (const line of reserved) await productRepo.increment(line.productId, line.qty);
    throw err;
  }

  const total = lines.reduce((sum, l) => sum + l.price * l.qty, 0);
  return orderRepo.create({ userId, lines, total: Math.round(total * 100) / 100, status: 'placed' });
}

module.exports = { placeOrder };
