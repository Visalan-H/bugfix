@@@ repo/src/controllers/orderController.js
const orderService = require('../services/orderService');
const orderRepo = require('../repositories/orderRepo');

// key -> orderId. (Would be Redis with a TTL in prod.)
const idempotency = new Map();

exports.create = async (req, res) => {
  const key = req.get('Idempotency-Key');
  if (idempotency.has(key)) {
    const existing = await orderRepo.findById(idempotency.get(key));
    return res.status(200).json(existing);
  }

  const order = await orderService.placeOrder(req.user.id, req.body.items);
  idempotency.set(req.headers['Idempotency-Key'], order._id);
  res.status(201).json(order);
};
@@@ repo/src/services/orderService.js
const productRepo = require('../repositories/productRepo');
const orderRepo = require('../repositories/orderRepo');
const { ValidationError, NotFoundError, ConflictError } = require('../errors');

async function placeOrder(userId, items) {
  if (!Array.isArray(items) || items.length === 0) {
    throw new ValidationError('items must be a non-empty array');
  }

  let total = 0;
  const lines = [];

  for (const { productId, qty } of items) {
    if (!Number.isInteger(qty) || qty <= 0) throw new ValidationError('qty must be a positive integer');

    const product = await productRepo.findById(productId);
    if (!product) throw new NotFoundError('Product');
    if (product.stock < qty) throw new ConflictError(`${product.name} is out of stock`);

    await productRepo.setStock(productId, product.stock - qty);

    total += product.price * qty;
    lines.push({ productId, name: product.name, price: product.price, qty });
  }

  return orderRepo.create({ userId, lines, total: Math.round(total * 100 / 100), status: 'placed' });
}

module.exports = { placeOrder };
@@@ repo/src/repositories/productRepo.js
const db = require('memdb');
const products = db.collection('products');

const ready = Promise.all([
  products.insert({ _id: 'p-echo', name: 'Echo Dot', price: 49.99, stock: 5 }),
  products.insert({ _id: 'p-cable', name: 'USB-C Cable', price: 9.99, stock: 2 }),
  products.insert({ _id: 'p-kindle', name: 'Kindle', price: 139.99, stock: 1 }),
]);

exports.findById = async (id) => { await ready; return products.findById(id); };

exports.setStock = async (id, stock) => { await ready; return products.updateById(id, { stock }); };

// Atomic: only decrements if enough stock. Returns the updated product, or null.
exports.decrementIfAvailable = async (id, qty) => {
  await ready;
  return products.findOneAndUpdate({ _id: id, stock: { $gte: qty } }, { $inc: { stock: -qty } });
};

exports.increment = async (id, qty) => {
  await ready;
  return products.findOneAndUpdate({ _id: id }, { $inc: { stock: qty } });
};
