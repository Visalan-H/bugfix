const express = require('express');
const auth = require('./middleware/auth');
const errorHandler = require('./middleware/errorHandler');
const orderController = require('./controllers/orderController');
const productController = require('./controllers/productController');

const app = express();
app.use(express.json());
app.use(auth);
app.get('/products/:id', productController.get);
app.post('/orders', orderController.create);
app.use(errorHandler);

module.exports = app;
@@@ repo/src/errors.js
class AppError extends Error {
  constructor(message, status) { super(message); this.name = this.constructor.name; this.status = status; }
}
class ValidationError extends AppError { constructor(m) { super(m, 400); } }
class NotFoundError extends AppError { constructor(w = 'Resource') { super(`${w} not found`, 404); } }
class ConflictError extends AppError { constructor(m) { super(m, 409); } }

module.exports = { AppError, ValidationError, NotFoundError, ConflictError };
