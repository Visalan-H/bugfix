@@@ repo/src/coupons.js
const db = require('memdb');
const clock = require('./clock');
const CATALOG = require('./catalog');

const redemptions = db.collection('redemptions');

class Reject extends Error { constructor(m) { super(m); this.status = 400; } }

async function checkout(userId, code, orderTotal) {
  const c = CATALOG[code];
  if (!c) throw new Reject('unknown coupon');
  if (clock.now() > Date.parse(c.validUntil)) throw new Reject('coupon expired');
  if (c.minOrder && !(orderTotal > c.minOrder)) throw new Reject(`minimum order is ${c.minOrder}`);

  if (c.perUser) {
    const used = await redemptions.count({ code: c.code });
    if (used >= c.perUser) throw new Reject('already used');
  }

  const discount = c.flat ? c.flat : orderTotal * c.percent / 100;
  await redemptions.insert({ code: c.code, userId, at: clock.now() });
  return { discount, total: orderTotal - discount };
}

module.exports = { checkout };
@@@ repo/src/app.js
const express = require('express');
const { checkout } = require('./coupons');

const app = express();
app.use(express.json());
app.post('/checkout', async (req, res) => {
  res.json(await checkout(req.get('x-user-id'), req.body.code, req.body.orderTotal));
});
app.use((err, req, res, next) => res.status(err.status || 500).json({ error: err.message }));

module.exports = app;
@@@ repo/tests/coupons.test.js
const request = require('supertest');
const app = require('../src/app');

const pay = (user, code, orderTotal) => request(app).post('/checkout').set('x-user-id', user).send({ code, orderTotal });

describe('Coupons', () => {
  test('WELCOME50 on exactly ₹300', async () => {
    const res = await pay('u1', 'WELCOME50', 300);
    expect(res.status).toBe(200);
    expect(res.body.total).toBe(250);
  });
  test('BIG20 is capped at ₹200', async () => {
    expect((await pay('u1', 'BIG20', 2000)).body).toEqual({ discount: 200, total: 1800 });
  });
  test('WELCOME50 is once per user, not once globally', async () => {
    expect((await pay('u1', 'WELCOME50', 500)).status).toBe(200);
    expect((await pay('u1', 'WELCOME50', 500)).status).toBe(400);
    expect((await pay('u2', 'WELCOME50', 500)).status).toBe(200);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/clock');

const pay = (user, code, orderTotal) => request(app).post('/checkout').set('x-user-id', user).send({ code, orderTotal });

describe('hidden', () => {
  test('valid on the afternoon of its last day', async () => {
    clock.set(Date.UTC(2026, 11, 31, 15, 0, 0));
    expect((await pay('u1', 'BIG20', 1000)).status).toBe(200);
  });
  test('expired the next day', async () => {
    clock.set(Date.UTC(2027, 0, 1, 0, 0, 1));
    expect((await pay('u1', 'BIG20', 1000)).status).toBe(400);
  });
  test('expired coupon → 400', async () => {
    expect((await pay('u1', 'SUMMER20', 1000)).status).toBe(400);
  });
  test('BIG20 under the cap', async () => {
    expect((await pay('u1', 'BIG20', 500)).body).toEqual({ discount: 100, total: 400 });
  });
  test('₹299 → 400', async () => {
    expect((await pay('u1', 'WELCOME50', 299)).status).toBe(400);
  });
  test('rejected checkout does not use up the coupon', async () => {
    await pay('u3', 'WELCOME50', 100);
    expect((await pay('u3', 'WELCOME50', 400)).status).toBe(200);
  });
});
@@@ solution/src/coupons.js
const db = require('memdb');
const clock = require('./clock');
const CATALOG = require('./catalog');

const redemptions = db.collection('redemptions');
const DAY_MS = 24 * 60 * 60 * 1000;

class Reject extends Error { constructor(m) { super(m); this.status = 400; } }

async function checkout(userId, code, orderTotal) {
  const c = CATALOG[code];
  if (!c) throw new Reject('unknown coupon');
  if (clock.now() >= Date.parse(c.validUntil) + DAY_MS) throw new Reject('coupon expired');
  if (c.minOrder && orderTotal < c.minOrder) throw new Reject(`minimum order is ${c.minOrder}`);

  if (c.perUser) {
    const used = await redemptions.count({ code: c.code, userId });
    if (used >= c.perUser) throw new Reject('already used');
  }

  const discount = c.flat ? c.flat : Math.min(orderTotal * c.percent / 100, c.maxDiscount ?? Infinity);
  await redemptions.insert({ code: c.code, userId, at: clock.now() });
  return { discount, total: orderTotal - discount };
}

module.exports = { checkout };
