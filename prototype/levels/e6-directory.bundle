  { name: 'Ankit Shah', team: 'Payments' },
  { name: 'Divya N', team: 'Search' },
  { name: 'Anand Kumar', team: 'Infra' },
  { name: 'Arjun P', team: 'Mobile' },
];
@@@ repo/tests/search.test.js
const request = require('supertest');
const app = require('../src/app');

const names = (res) => res.body.map((u) => u.name);

describe('Directory search', () => {
  test('prefix match, case-insensitive, sorted', async () => {
    const res = await request(app).get('/users/search?q=an');
    expect(names(res)).toEqual(['Anand Kumar', 'Anitha R', 'Ankit Shah']);
  });

  test('no q returns the first 5 alphabetically', async () => {
    const res = await request(app).get('/users/search');
    expect(res.status).toBe(200);
    expect(names(res)).toEqual(['Anand Kumar', 'Anitha R', 'Ankit Shah', 'Arjun P', 'Bhavana S']);
  });

  test('limit is capped, not an error', async () => {
    const res = await request(app).get('/users/search?limit=50');
    expect(res.status).toBe(200);
    expect(res.body).toHaveLength(8);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const names = (res) => res.body.map((u) => u.name);

describe('hidden', () => {
  test('uppercase query', async () => {
    expect(names(await request(app).get('/users/search?q=AN'))).toEqual(['Anand Kumar', 'Anitha R', 'Ankit Shah']);
  });
  test('padded query is trimmed', async () => {
    expect(names(await request(app).get('/users/search?q=%20an%20'))).toEqual(['Anand Kumar', 'Anitha R', 'Ankit Shah']);
  });
  test('no match → []', async () => {
    expect((await request(app).get('/users/search?q=zz')).body).toEqual([]);
  });
  test('limit=2', async () => {
    expect(names(await request(app).get('/users/search?limit=2'))).toEqual(['Anand Kumar', 'Anitha R']);
  });
});
@@@ solution/src/app.js
const express = require('express');
const people = require('./people');

const app = express();

app.get('/users/search', (req, res) => {
  const q = (req.query.q || '').trim().toLowerCase();
  const limit = Math.min(parseInt(req.query.limit, 10) || 5, 20);

  const matches = people
    .filter((u) => !q || u.name.toLowerCase().startsWith(q))
    .sort((a, b) => a.name.localeCompare(b.name))
    .slice(0, limit);

  res.json(matches);
});

module.exports = app;
