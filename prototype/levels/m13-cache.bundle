@@@ repo/src/clock.js
let t = Date.UTC(2026, 0, 1);
module.exports = { now: () => t, advance: (ms) => { t += ms; } };
@@@ repo/src/cache.js
const clock = require('./clock');

const TTL_SECONDS = 30;
const store = new Map();
const stats = { hits: 0, misses: 0 };

function middleware(req, res, next) {
  const key = req.path;
  const hit = store.get(key);
  if (hit && hit.expires > clock.now()) {
    stats.hits++;
    req.cached = hit.value;
  } else {
    stats.misses++;
  }
  req.cacheKey = key;
  next();
}

function put(key, value) {
  store.set(key, { value, expires: clock.now() + TTL_SECONDS });
}

module.exports = { middleware, put, clear: () => store.clear(), stats };
@@@ repo/src/app.js
const express = require('express');
const db = require('memdb');
const cache = require('./cache');

const products = db.collection('products');
const ready = Promise.all([
  products.insert({ name: 'Mug', price: 100 }),
  products.insert({ name: 'Lamp', price: 500 }),
  products.insert({ name: 'Mat', price: 250 }),
]);

const app = express();
app.use(express.json());

app.get('/products', cache.middleware, async (req, res) => {
  let data = req.cached;
  if (!data) {
    await ready;
    const page = Number(req.query.page) || 1;
    const all = await products.find({});
    data = { page, items: all.slice((page - 1) * 2, page * 2) };
    cache.put(req.cacheKey, data);
  }
  data.items.forEach((i) => {
    i.price = Math.round(i.price * 1.18);
    i.priceWithGst = i.price;
  });
  res.json(data);
});

app.post('/products', async (req, res) => {
  await ready;
  res.status(201).json(await products.insert({ name: req.body.name, price: req.body.price }));
});

app.get('/cache/stats', (req, res) => res.json(cache.stats));

module.exports = app;
@@@ repo/tests/cache.test.js
const request = require('supertest');
const app = require('../src/app');

const page = (n) => request(app).get(`/products?page=${n}`);

describe('Cache', () => {
  test('page 2 is page 2', async () => {
    await page(1);
    const res = await page(2);
    expect(res.body.items.map((i) => i.name)).toEqual(['Mat']);
  });
  test('second identical request is a hit', async () => {
    await page(1);
    await page(1);
    expect((await request(app).get('/cache/stats')).body).toEqual({ hits: 1, misses: 1 });
  });
  test('cached responses are identical', async () => {
    const a = await page(1);
    const b = await page(1);
    expect(b.body).toEqual(a.body);
    expect(b.body.items[0]).toEqual({ name: 'Mug', price: 100, priceWithGst: 118, _id: a.body.items[0]._id });
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/clock');

describe('hidden', () => {
  test('new product appears immediately', async () => {
    await request(app).get('/products?page=2');
    await request(app).post('/products').send({ name: 'Pen', price: 20 });
    const res = await request(app).get('/products?page=2');
    expect(res.body.items.map((i) => i.name)).toEqual(['Mat', 'Pen']);
  });
  test('expires after 30s', async () => {
    await request(app).get('/products?page=1');
    clock.advance(31 * 1000);
    await request(app).get('/products?page=1');
    expect((await request(app).get('/cache/stats')).body).toEqual({ hits: 0, misses: 2 });
  });
  test('still cached at 29s', async () => {
    await request(app).get('/products?page=1');
    clock.advance(29 * 1000);
    await request(app).get('/products?page=1');
    expect((await request(app).get('/cache/stats')).body.hits).toBe(1);
  });
});
@@@ solution/src/cache.js
const clock = require('./clock');

const TTL_SECONDS = 30;
const store = new Map();
const stats = { hits: 0, misses: 0 };

function middleware(req, res, next) {
  const key = req.url;
  const hit = store.get(key);
  if (hit && hit.expires > clock.now()) {
    stats.hits++;
    req.cached = hit.value;
  } else {
    stats.misses++;
  }
  req.cacheKey = key;
  next();
}

function put(key, value) {
  store.set(key, { value, expires: clock.now() + TTL_SECONDS * 1000 });
}

module.exports = { middleware, put, clear: () => store.clear(), stats };
@@@ solution/src/app.js
const express = require('express');
const db = require('memdb');
const cache = require('./cache');

const products = db.collection('products');
const ready = Promise.all([
  products.insert({ name: 'Mug', price: 100 }),
  products.insert({ name: 'Lamp', price: 500 }),
  products.insert({ name: 'Mat', price: 250 }),
]);

const app = express();
app.use(express.json());

app.get('/products', cache.middleware, async (req, res) => {
  let data = req.cached;
  if (!data) {
    await ready;
    const page = Number(req.query.page) || 1;
    const all = await products.find({});
    data = { page, items: all.slice((page - 1) * 2, page * 2) };
    cache.put(req.cacheKey, data);
  }
  res.json({
    page: data.page,
    items: data.items.map((i) => ({ ...i, priceWithGst: Math.round(i.price * 1.18) })),
  });
});

app.post('/products', async (req, res) => {
  await ready;
  const p = await products.insert({ name: req.body.name, price: req.body.price });
  cache.clear();
  res.status(201).json(p);
});

app.get('/cache/stats', (req, res) => res.json(cache.stats));

module.exports = app;
