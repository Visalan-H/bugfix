const { AuthError } = require('../errors');

module.exports = function requireUser(req, res, next) {
  const id = req.get('x-user-id');
  if (!id) throw new AuthError();
  req.userId = id;
  next();
};
@@@ repo/src/routes/users.js
const express = require('express');
const service = require('../services/userService');
const requireUser = require('../middleware/requireUser');

const router = express.Router();

router.post('/', async (req, res) => {
  const user = await service.signup(req.body);
  res.status(201).json(user);
});

router.get('/me', requireUser, async (req, res) => {
  res.json(await service.getProfile(req.userId));
});

router.patch('/me', requireUser, async (req, res) => {
  res.json(await service.updateProfile(req.userId, req.body));
});

module.exports = router;
@@@ repo/src/services/userService.js
const repo = require('../repositories/userRepo');
const { hash } = require('../lib/hash');
const { ValidationError, ConflictError, NotFoundError } = require('../errors');

function toPublic(user) {
  const { passwordHash, ...safe } = user;
  return safe;
}

async function signup({ email, password, name }) {
  if (!email || !password || !name) throw new ValidationError('email, password and name are required');

  const existing = repo.findByEmail(email);
  if (existing) throw new ConflictError('email already registered');

  const user = await repo.insert({ email, name, bio: '', role: 'user', passwordHash: hash(password) });
  const { passwordHash, ...safe } = user;
  return user;
}

async function getProfile(id) {
  const user = await repo.findById(id);
  if (!user) throw new NotFoundError('user not found');
  return toPublic(user);
}

async function updateProfile(id, changes) {
  const user = await repo.findById(id);
  if (!user) throw new NotFoundError('user not found');
  const updated = await repo.update(id, changes);
  return toPublic(updated);
}

module.exports = { signup, getProfile, updateProfile };
@@@ repo/src/repositories/userRepo.js
const db = require('memdb');
const users = db.collection('users');

exports.findByEmail = (email) => users.findOne({ email });
exports.findById = (id) => users.findById(id);
exports.insert = (doc) => users.insert(doc);
exports.update = (id, patch) => users.updateById(id, patch);
@@@ repo/src/lib/hash.js
// Stand-in for bcrypt. Not the bug.
exports.hash = (s) => 'h$' + s.split('').reverse().join('');
@@@ repo/tests/users.test.js
const request = require('supertest');
const app = require('../src/app');

const signup = (body) => request(app).post('/users').send(body);

describe('Users', () => {
  test('signup works and returns 201', async () => {
    const res = await signup({ email: 'meera@example.com', password: 'pw-123456', name: 'Meera' });
    expect(res.status).toBe(201);
    expect(res.body.email).toBe('meera@example.com');
    expect(res.body.role).toBe('user');
  });

  test('signup response never includes passwordHash', async () => {
    const res = await signup({ email: 'arun@example.com', password: 'pw-123456', name: 'Arun' });
    expect(res.body._id).toBeDefined();
    expect(res.body.passwordHash).toBeUndefined();
  });

  test('duplicate email → 409', async () => {
    await signup({ email: 'dup@example.com', password: 'pw-123456', name: 'One' });
    const res = await signup({ email: 'dup@example.com', password: 'pw-654321', name: 'Two' });
    expect(res.status).toBe(409);
  });

  test('PATCH /users/me cannot change role', async () => {
    const u = await signup({ email: 'eve@example.com', password: 'pw-123456', name: 'Eve' });
    const res = await request(app).patch('/users/me').set('x-user-id', u.body._id).send({ name: 'Eve 2', role: 'admin' });
    expect(res.status).toBe(200);
    expect(res.body.name).toBe('Eve 2');
    expect(res.body.role).toBe('user');
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const signup = (body) => request(app).post('/users').send(body);

describe('hidden', () => {
  test('duplicate check is case-insensitive', async () => {
    await signup({ email: 'Case@Example.com', password: 'pw-123456', name: 'A' });
    const res = await signup({ email: 'case@example.com', password: 'pw-123456', name: 'B' });
    expect(res.status).toBe(409);
  });

  test('stored email is normalised', async () => {
    const res = await signup({ email: '  Mixed@Example.COM ', password: 'pw-123456', name: 'M' });
    expect(res.body.email).toBe('mixed@example.com');
  });

  test('PATCH cannot overwrite passwordHash', async () => {
    const u = await signup({ email: 'x@example.com', password: 'pw-123456', name: 'X' });
    await request(app).patch('/users/me').set('x-user-id', u.body._id).send({ passwordHash: 'h$evil' });
    const stored = await require('../src/repositories/userRepo').findById(u.body._id);
    expect(stored.passwordHash).not.toBe('h$evil');
  });

  test('bio can be updated', async () => {
    const u = await signup({ email: 'b@example.com', password: 'pw-123456', name: 'B' });
    const res = await request(app).patch('/users/me').set('x-user-id', u.body._id).send({ bio: 'hi' });
    expect(res.body.bio).toBe('hi');
  });

  test('missing fields → 400', async () => {
    const res = await signup({ email: 'n@example.com' });
    expect(res.status).toBe(400);
  });

  test('GET /users/me without header → 401', async () => {
    const res = await request(app).get('/users/me');
    expect(res.status).toBe(401);
  });
});
@@@ solution/src/services/userService.js
const repo = require('../repositories/userRepo');
const { hash } = require('../lib/hash');
const { ValidationError, ConflictError, NotFoundError } = require('../errors');

const EDITABLE = ['name', 'bio'];

function toPublic(user) {
  const { passwordHash, ...safe } = user;
  return safe;
}

function pick(obj, fields) {
  const out = {};
  for (const f of fields) if (obj[f] !== undefined) out[f] = obj[f];
  return out;
}

async function signup({ email, password, name }) {
  if (!email || !password || !name) throw new ValidationError('email, password and name are required');
  email = email.trim().toLowerCase();

  const existing = await repo.findByEmail(email);
  if (existing) throw new ConflictError('email already registered');

  const user = await repo.insert({ email, name, bio: '', role: 'user', passwordHash: hash(password) });
  return toPublic(user);
}

async function getProfile(id) {
  const user = await repo.findById(id);
  if (!user) throw new NotFoundError('user not found');
  return toPublic(user);
}

async function updateProfile(id, changes) {
  const user = await repo.findById(id);
  if (!user) throw new NotFoundError('user not found');
  const updated = await repo.update(id, pick(changes, EDITABLE));
  return toPublic(updated);
}

module.exports = { signup, getProfile, updateProfile };
