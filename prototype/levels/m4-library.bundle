      ],
      "cause": "`(returnedAt - dueAt) / 86400` treats ms as seconds, so 2 days late becomes 2,000 'days'.",
      "fix": "`Math.ceil((returnedAt - dueAt) / DAY_MS)` with `const DAY_MS = 24 * 60 * 60 * 1000`",
      "pattern": "Seconds vs milliseconds"
    },
    {
      "symptom": "Returning on time gives a negative fee",
      "file": "src/services/loanService.js",
      "hints": [
        "What is `returnedAt - dueAt` when the book comes back early?"
      ],
      "cause": "Before the due date the difference is negative, so the 'late days' and the fee go negative and the member gets credit.",
      "fix": "`const lateDays = Math.max(0, Math.ceil((returnedAt - dueAt) / DAY_MS));`",
      "pattern": "Unclamped negative"
    },
    {
      "symptom": "Can't borrow again after returning a book (limit hit)",
      "file": "src/repositories/loanRepo.js",
      "hints": [
        "What does countActive actually count?"
      ],
      "cause": "`countActive` counts every loan the member ever had, returned ones included, so after 3 lifetime loans the member is locked out.",
      "fix": "`loans.count({ memberId, returnedAt: null })`",
      "pattern": "Filter missing a state condition"
    },
    {
      "symptom": "Returning the same loan twice increases stock",
      "file": "src/services/loanService.js",
      "hints": [
        "What stops a loan that already has returnedAt from being returned again?"
      ],
      "cause": "There's no guard, so a second return charges the fee again and increments `available` again. The library now has phantom copies.",
