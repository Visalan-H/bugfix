const express = require('express');
const service = require('../services/loanService');

const router = express.Router();

router.post('/', async (req, res) => {
  const loan = await service.borrow(req.memberId, req.body.bookId);
  res.status(201).json(loan);
});

router.post('/:id/return', async (req, res) => {
  const loan = await service.returnLoan(req.memberId, req.params.id);
  res.json(loan);
});

module.exports = router;
@@@ repo/src/services/loanService.js
const loanRepo = require('../repositories/loanRepo');
const bookRepo = require('../repositories/bookRepo');
const clock = require('../lib/clock');
const { NotFoundError, ConflictError, ForbiddenError } = require('../errors');

const MAX_ACTIVE = 3;
const LOAN_DAYS = 14;
const FEE_PER_DAY = 10;
const DAY_MS = 24 * 60 * 60 * 1000;

async function borrow(memberId, bookId) {
  const book = await bookRepo.findById(bookId);
  if (!book) throw new NotFoundError('book not found');
  if (book.available < 0) throw new ConflictError('no copies available');

  const active = await loanRepo.countActive(memberId);
  if (active >= MAX_ACTIVE) throw new ConflictError(`max ${MAX_ACTIVE} active loans`);

  await bookRepo.adjustAvailable(bookId, -1);
  const now = clock.now();
  return loanRepo.create({ memberId, bookId, borrowedAt: now, dueAt: now + LOAN_DAYS * DAY_MS, returnedAt: null });
}

async function returnLoan(memberId, loanId) {
  const loan = await loanRepo.findById(loanId);
  if (!loan) throw new NotFoundError('loan not found');
  if (loan.memberId !== memberId) throw new ForbiddenError();

  const returnedAt = clock.now();
  const lateDays = Math.ceil((returnedAt - loan.dueAt) / 86400);
  const fee = lateDays * FEE_PER_DAY;

  await bookRepo.adjustAvailable(loan.bookId, +1);
  return loanRepo.update(loan._id, { returnedAt, fee });
}

module.exports = { borrow, returnLoan };
@@@ repo/src/repositories/loanRepo.js
const db = require('memdb');
const loans = db.collection('loans');

exports.create = (doc) => loans.insert(doc);
exports.findById = (id) => loans.findById(id);
exports.update = (id, patch) => loans.updateById(id, patch);
exports.countActive = (memberId) => loans.count({ memberId });
@@@ repo/src/repositories/bookRepo.js
const db = require('memdb');
const books = db.collection('books');

const ready = Promise.all([
  books.insert({ _id: 'b-sapiens', title: 'Sapiens', available: 5 }),
  books.insert({ _id: 'b-ponniyin', title: 'Ponniyin Selvan', available: 1 }),
  books.insert({ _id: 'b-ddia', title: 'Designing Data-Intensive Applications', available: 4 }),
]);

exports.findById = async (id) => { await ready; return books.findById(id); };
exports.adjustAvailable = async (id, delta) => {
  await ready;
  return books.findOneAndUpdate({ _id: id }, { $inc: { available: delta } });
};
@@@ repo/src/lib/clock.js
// Frozen clock: time only moves when a test advances it.
const START = Date.UTC(2026, 0, 5, 9, 0, 0);
let offset = 0;
const DAY = 24 * 60 * 60 * 1000;

module.exports = {
  now: () => START + offset,
  advance: (ms) => { offset += ms; },
  advanceDays: (d) => { offset += d * DAY; },
};
@@@ repo/tests/loans.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/lib/clock');

const as = (m) => ({
  borrow: (bookId) => request(app).post('/loans').set('x-member-id', m).send({ bookId }),
  ret: (id) => request(app).post(`/loans/${id}/return`).set('x-member-id', m),
  book: (id) => request(app).get(`/books/${id}`).set('x-member-id', m),
});
const priya = as('priya');

describe('Loans', () => {
  test('2 days late → ₹20 fee', async () => {
    const loan = await priya.borrow('b-sapiens');
    clock.advanceDays(16);
    const res = await priya.ret(loan.body._id);
    expect(res.status).toBe(200);
    expect(res.body.fee).toBe(20);
  });

  test('returning early → fee 0', async () => {
    const loan = await priya.borrow('b-sapiens');
    clock.advanceDays(3);
    const res = await priya.ret(loan.body._id);
    expect(res.body.fee).toBe(0);
  });

  test('returned loans don\'t count toward the 3-loan limit', async () => {
    const first = await priya.borrow('b-sapiens');
    await priya.borrow('b-sapiens');
    await priya.borrow('b-ddia');
    await priya.ret(first.body._id);
    const res = await priya.borrow('b-ddia');
    expect(res.status).toBe(201);
  });

  test('a loan can only be returned once', async () => {
    const loan = await priya.borrow('b-ddia');
    await priya.ret(loan.body._id);
    const again = await priya.ret(loan.body._id);
    expect(again.status).toBe(409);
    expect((await priya.book('b-ddia')).body.available).toBe(4);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/lib/clock');

const as = (m) => ({
  borrow: (bookId) => request(app).post('/loans').set('x-member-id', m).send({ bookId }),
  ret: (id) => request(app).post(`/loans/${id}/return`).set('x-member-id', m),
  book: (id) => request(app).get(`/books/${id}`).set('x-member-id', m),
});

describe('hidden', () => {
  test('cannot borrow the last copy twice', async () => {
    expect((await as('a').borrow('b-ponniyin')).status).toBe(201);
    const res = await as('b').borrow('b-ponniyin');
    expect(res.status).toBe(409);
    expect((await as('b').book('b-ponniyin')).body.available).toBe(0);
  });

  test('one hour late = one day fee', async () => {
    const loan = await as('a').borrow('b-sapiens');
    clock.advanceDays(14);
    clock.advance(60 * 60 * 1000);
    const res = await as('a').ret(loan.body._id);
    expect(res.body.fee).toBe(10);
  });

  test('returning exactly on the due moment → 0', async () => {
    const loan = await as('a').borrow('b-sapiens');
    clock.advanceDays(14);
    const res = await as('a').ret(loan.body._id);
    expect(res.body.fee).toBe(0);
  });

  test('4th active loan → 409', async () => {
    const a = as('a');
    await a.borrow('b-sapiens'); await a.borrow('b-sapiens'); await a.borrow('b-ddia');
    const res = await a.borrow('b-ddia');
    expect(res.status).toBe(409);
  });

  test('cannot return someone else\'s loan', async () => {
    const loan = await as('a').borrow('b-sapiens');
    const res = await as('b').ret(loan.body._id);
    expect(res.status).toBe(403);
  });
});
@@@ solution/src/services/loanService.js
const loanRepo = require('../repositories/loanRepo');
const bookRepo = require('../repositories/bookRepo');
const clock = require('../lib/clock');
const { NotFoundError, ConflictError, ForbiddenError } = require('../errors');

const MAX_ACTIVE = 3;
const LOAN_DAYS = 14;
const FEE_PER_DAY = 10;
const DAY_MS = 24 * 60 * 60 * 1000;

async function borrow(memberId, bookId) {
  const book = await bookRepo.findById(bookId);
  if (!book) throw new NotFoundError('book not found');
  if (book.available < 1) throw new ConflictError('no copies available');

  const active = await loanRepo.countActive(memberId);
  if (active >= MAX_ACTIVE) throw new ConflictError(`max ${MAX_ACTIVE} active loans`);

  await bookRepo.adjustAvailable(bookId, -1);
  const now = clock.now();
  return loanRepo.create({ memberId, bookId, borrowedAt: now, dueAt: now + LOAN_DAYS * DAY_MS, returnedAt: null });
}

async function returnLoan(memberId, loanId) {
  const loan = await loanRepo.findById(loanId);
  if (!loan) throw new NotFoundError('loan not found');
  if (loan.memberId !== memberId) throw new ForbiddenError();
  if (loan.returnedAt !== null) throw new ConflictError('loan already returned');

  const returnedAt = clock.now();
  const lateDays = Math.max(0, Math.ceil((returnedAt - loan.dueAt) / DAY_MS));
  const fee = lateDays * FEE_PER_DAY;

  await bookRepo.adjustAvailable(loan.bookId, +1);
  return loanRepo.update(loan._id, { returnedAt, fee });
}

module.exports = { borrow, returnLoan };
@@@ solution/src/repositories/loanRepo.js
const db = require('memdb');
const loans = db.collection('loans');

exports.create = (doc) => loans.insert(doc);
exports.findById = (id) => loans.findById(id);
exports.update = (id, patch) => loans.updateById(id, patch);
exports.countActive = (memberId) => loans.count({ memberId, returnedAt: null });
