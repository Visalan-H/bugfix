@@@ repo/src/app.js
const express = require('express');
const ctrl = require('./controllers/watchlistController');
const errorHandler = require('./middleware/errorHandler');

const app = express();
app.use(express.json());
app.use((req, res, next) => {
  const id = req.get('x-user-id');
  if (!id) return res.status(401).json({ error: 'unauthenticated' });
  req.userId = id;
  next();
});
app.get('/watchlist', ctrl.get);
app.post('/watchlist', ctrl.add);
app.delete('/watchlist/:movieId', ctrl.remove);
app.use(errorHandler);

module.exports = app;
@@@ repo/src/errors.js
class AppError extends Error { constructor(m, status) { super(m); this.status = status; } }
class NotFoundError extends AppError { constructor(m = 'not found') { super(m, 404); } }
class ConflictError extends AppError { constructor(m) { super(m, 409); } }

module.exports = { NotFoundError, ConflictError };
@@@ repo/src/middleware/errorHandler.js
module.exports = function errorHandler(err, req, res, next) {
  const status = err.status || 500;
  if (status === 500) console.error(err);
  res.status(status).json({ error: err.message });
};
@@@ repo/src/controllers/watchlistController.js
const service = require('../services/watchlistService');
const movieRepo = require('../repositories/movieRepo');

exports.get = async (req, res) => {
  res.json(await service.getList(req.userId));
};

exports.add = async (req, res) => {
  const { movieId } = req.body;
  const movie = await movieRepo.findById(movieId);
  if (!movie) {
    res.status(404).json({ error: 'movie not found' });
  }
  const list = await service.addMovie(req.userId, movieId);
  res.status(201).json(list);
};

exports.remove = async (req, res) => {
  await service.removeMovie(req.userId, req.params.movieId);
  res.status(204).end();
};
@@@ repo/src/services/watchlistService.js
const repo = require('../repositories/watchlistRepo');
const movieRepo = require('../repositories/movieRepo');
const { ConflictError } = require('../errors');

async function getList(userId) {
  const wl = await repo.getOrCreate(userId);
  const items = await Promise.all(wl.items.map(async (i) => {
    const movie = await movieRepo.findById(i.movieId);
    return { ...i, title: movie ? movie.title : null };
  }));
  return { items };
}

async function addMovie(userId, movieId) {
  const wl = await repo.getOrCreate(userId);
  if (wl.items.includes({ movieId })) {
    throw new ConflictError('movie already in watch list');
  }
  wl.items.push({ movieId, addedAt: Date.now() });
  repo.save(wl);
  return getList(userId);
}

async function removeMovie(userId, movieId) {
  const wl = await repo.getOrCreate(userId);
  wl.items.filter((i) => i.movieId !== movieId);
  await repo.save(wl);
}

module.exports = { getList, addMovie, removeMovie };
@@@ repo/src/repositories/watchlistRepo.js
const db = require('memdb');
const lists = db.collection('watchlists');

exports.getOrCreate = async (userId) => {
  const found = await lists.findOne({ userId });
  if (found) return found;
  return lists.insert({ userId, items: [] });
};

exports.save = (wl) => lists.updateById(wl._id, { items: wl.items });
@@@ repo/src/repositories/movieRepo.js
const db = require('memdb');
const movies = db.collection('movies');

const ready = Promise.all([
  movies.insert({ _id: 'm1', title: 'Inception' }),
  movies.insert({ _id: 'm2', title: 'Arrival' }),
  movies.insert({ _id: 'm3', title: 'Dune' }),
  movies.insert({ _id: 'm4', title: 'Interstellar' }),
]);

exports.findById = async (id) => { await ready; return movies.findById(id); };
@@@ repo/tests/watchlist.test.js
const request = require('supertest');
const app = require('../src/app');

const u = 'u1';
const add = (movieId) => request(app).post('/watchlist').set('x-user-id', u).send({ movieId });
const list = () => request(app).get('/watchlist').set('x-user-id', u);
const del = (movieId) => request(app).delete(`/watchlist/${movieId}`).set('x-user-id', u);

describe('Watch list', () => {
  test('add a movie', async () => {
    const res = await add('m1');
    expect(res.status).toBe(201);
    expect(res.body.items).toHaveLength(1);
    expect(res.body.items[0].title).toBe('Inception');
  });

  test('adding the same movie twice → 409', async () => {
    await add('m2');
    const res = await add('m2');
    expect(res.status).toBe(409);
    expect((await list()).body.items).toHaveLength(1);
  });

  test('unknown movie → 404 and nothing is added', async () => {
    const res = await add('m999');
    expect(res.status).toBe(404);
    expect((await list()).body.items).toHaveLength(0);
  });

  test('removed movie stays removed', async () => {
    await add('m1');
    await add('m3');
    const res = await del('m1');
    expect(res.status).toBe(204);
    const after = await list();
    expect(after.body.items.map((i) => i.movieId)).toEqual(['m3']);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const as = (u) => ({
  add: (movieId) => request(app).post('/watchlist').set('x-user-id', u).send({ movieId }),
  list: () => request(app).get('/watchlist').set('x-user-id', u),
  del: (movieId) => request(app).delete(`/watchlist/${movieId}`).set('x-user-id', u),
});

describe('hidden', () => {
  test('removing a movie not in the list → 404', async () => {
    const a = as('a');
    await a.add('m1');
    const res = await a.del('m4');
    expect(res.status).toBe(404);
  });

  test('lists are per user', async () => {
    await as('a').add('m1');
    const res = await as('b').list();
    expect(res.body.items).toHaveLength(0);
  });

  test('can re-add after removing', async () => {
    const a = as('a');
    await a.add('m2');
    await a.del('m2');
    const res = await a.add('m2');
    expect(res.status).toBe(201);
  });

  test('a 409 does not change the list', async () => {
    const a = as('a');
    await a.add('m1');
    await a.add('m2');
    await a.add('m1');
    const res = await a.list();
    expect(res.body.items.map((i) => i.movieId)).toEqual(['m1', 'm2']);
  });

  test('missing x-user-id → 401', async () => {
    const res = await request(app).get('/watchlist');
    expect(res.status).toBe(401);
  });
});
