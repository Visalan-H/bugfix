@@@ ticket.md
# GAME-6: Leaderboard is nonsense

| Method | Path | Behaviour |
|---|---|---|
| `POST` | `/scores { player, score }` | Keeps each player's **best** score. score must be a number ≥ 0 → else **400** |
| `GET` | `/leaderboard?top=` | `[{ rank, player, score }]`, best first. Default top **10**. Ranks are 1-based; ties share a rank (1, 2, 2, 4) |
@@@ repo/package.json
{ "name": "leaderboard", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/board.js
const best = new Map(); // player -> score

function submit(player, score) {
  const existing = best.has(player) ? { score: best.get(player) } : undefined;
  best.set(player, Math.max(score, existing?.score));
}

function top(n) {
  return [...best.entries()]
    .map(([player, score]) => ({ player, score }))
    .slice(0, n)
    .sort((a, b) => b.score - a.score)
    .map((p, i) => ({ rank: i, ...p }));
}

module.exports = { submit, top };
@@@ repo/src/app.js
const express = require('express');
const board = require('./board');

const app = express();
app.use(express.json());

app.post('/scores', (req, res) => {
  const { player, score } = req.body;
  if (!player || typeof score !== 'number' || score < 0) return res.status(400).json({ error: 'bad score' });
  board.submit(player, score);
  res.status(201).json({ ok: true });
});

app.get('/leaderboard', (req, res) => {
  res.json(board.top(Number(req.query.top) || 10));
});

module.exports = app;
@@@ repo/tests/board.test.js
const request = require('supertest');
const app = require('../src/app');

const submit = (player, score) => request(app).post('/scores').send({ player, score });
const board = (q = '') => request(app).get('/leaderboard' + q);

describe('Leaderboard', () => {
  test('a new player shows their score', async () => {
    await submit('ana', 50);
    expect((await board()).body).toEqual([{ rank: 1, player: 'ana', score: 50 }]);
  });
  test('ranks are 1-based and ties share a rank', async () => {
    await submit('a', 100); await submit('b', 90); await submit('c', 90); await submit('d', 80);
    expect((await board()).body.map((r) => r.rank)).toEqual([1, 2, 2, 4]);
  });
  test('top=2 returns the two best', async () => {
    await submit('low', 10); await submit('mid', 50); await submit('high', 99);
    expect((await board('?top=2')).body.map((r) => r.player)).toEqual(['high', 'mid']);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const submit = (player, score) => request(app).post('/scores').send({ player, score });

describe('hidden', () => {
  test('a lower score does not replace the best', async () => {
    await submit('x', 70); await submit('x', 20);
    expect((await request(app).get('/leaderboard')).body[0].score).toBe(70);
  });
  test('a higher score replaces it', async () => {
    await submit('x', 70); await submit('x', 85);
    expect((await request(app).get('/leaderboard')).body[0].score).toBe(85);
  });
  test('score 0 is valid', async () => {
    expect((await submit('z', 0)).status).toBe(201);
    expect((await request(app).get('/leaderboard')).body[0]).toEqual({ rank: 1, player: 'z', score: 0 });
  });
  test('bad scores → 400', async () => {
    expect((await submit('q', -1)).status).toBe(400);
    expect((await submit('q', '5')).status).toBe(400);
  });
});
@@@ solution/src/board.js
const best = new Map(); // player -> score

function submit(player, score) {
  const prev = best.get(player);
  best.set(player, prev === undefined ? score : Math.max(score, prev));
}

function top(n) {
  const sorted = [...best.entries()]
    .map(([player, score]) => ({ player, score }))
    .sort((a, b) => b.score - a.score);
  const ranked = [];
  sorted.forEach((p, i) => {
    const rank = i > 0 && p.score === sorted[i - 1].score ? ranked[i - 1].rank : i + 1;
    ranked.push({ rank, ...p });
  });
  return ranked.slice(0, n);
}

module.exports = { submit, top };
