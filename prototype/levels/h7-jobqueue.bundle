      "file": "src/queue.js",
      "hints": ["When is a running job reclaimable: before or after leaseUntil?"],
      "cause": "The reclaim condition `leaseUntil > now` targets LIVE leases, so it steals jobs from healthy workers while expired ones never come back.",
      "fix": "Second claim attempt: `{ status: 'running', leaseUntil: { $lte: now } }`",
      "pattern": "Inverted lease check"
