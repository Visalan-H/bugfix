@@@ repo/src/clock.js
let t = Date.UTC(2026, 0, 1);
module.exports = { now: () => t, advance: (ms) => { t += ms; } };
@@@ repo/src/queue.js
const db = require('memdb');
const clock = require('./clock');

const jobs = db.collection('jobs');
const LEASE_MS = 30 * 1000;
let seq = 0;

async function enqueue(type) {
  return jobs.insert({ type, seq: ++seq, status: 'queued', worker: null, leaseUntil: null });
}

async function claim(worker) {
  const now = clock.now();
  const candidates = (await jobs.find({}))
    .filter((j) => j.status === 'queued' || (j.status === 'running' && j.leaseUntil > now))
    .sort((a, b) => b.seq - a.seq);
  const job = candidates[0];
  if (!job) return null;
  return jobs.updateById(job._id, { status: 'running', worker, leaseUntil: now + LEASE_MS });
}

async function complete(worker, id) {
  const job = await jobs.findById(id);
  if (!job || job.status !== 'running') return null;
  return jobs.updateById(id, { status: 'done' });
}

module.exports = { enqueue, claim, complete };
@@@ repo/src/app.js
const express = require('express');
const q = require('./queue');

const app = express();
app.use(express.json());
app.post('/jobs', async (req, res) => res.status(201).json(await q.enqueue(req.body.type)));
app.post('/workers/:w/claim', async (req, res) => {
  const job = await q.claim(req.params.w);
  if (!job) return res.status(204).end();
  res.json(job);
});
app.post('/workers/:w/jobs/:id/complete', async (req, res) => {
  const job = await q.complete(req.params.w, req.params.id);
  if (!job) return res.status(409).json({ error: 'not your running job' });
  res.json(job);
});

module.exports = app;
@@@ repo/tests/queue.test.js
const request = require('supertest');
const app = require('../src/app');

const enqueue = (type) => request(app).post('/jobs').send({ type });
const claim = (w) => request(app).post(`/workers/${w}/claim`);

describe('Queue', () => {
  test('oldest job first', async () => {
    await enqueue('first'); await enqueue('second');
    expect((await claim('w1')).body.type).toBe('first');
  });
  test('concurrent claims never share a job', async () => {
    await enqueue('only');
    const [a, b] = await Promise.all([claim('w1'), claim('w2')]);
    expect([a.status, b.status].sort()).toEqual([200, 204]);
  });
  test('only the holder can complete', async () => {
    await enqueue('x');
    const job = (await claim('w1')).body;
    expect((await request(app).post(`/workers/w2/jobs/${job._id}/complete`)).status).toBe(409);
    expect((await request(app).post(`/workers/w1/jobs/${job._id}/complete`)).status).toBe(200);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/clock');

const enqueue = (type) => request(app).post('/jobs').send({ type });
const claim = (w) => request(app).post(`/workers/${w}/claim`);

describe('hidden', () => {
  test('expired lease → job can be reclaimed', async () => {
    await enqueue('x');
    await claim('w1');
    clock.advance(31 * 1000);
    const res = await claim('w2');
    expect(res.status).toBe(200);
    expect(res.body.worker).toBe('w2');
  });
  test('live lease → not reclaimable', async () => {
    await enqueue('x');
    await claim('w1');
    clock.advance(10 * 1000);
    expect((await claim('w2')).status).toBe(204);
  });
  test('old holder cannot complete after losing the lease', async () => {
    await enqueue('x');
    const job = (await claim('w1')).body;
    clock.advance(31 * 1000);
    await claim('w2');
    expect((await request(app).post(`/workers/w1/jobs/${job._id}/complete`)).status).toBe(409);
  });
  test('5 workers, 3 jobs → 3 distinct claims', async () => {
    await enqueue('a'); await enqueue('b'); await enqueue('c');
    const rs = await Promise.all([1, 2, 3, 4, 5].map((i) => claim(`w${i}`)));
    const ids = rs.filter((r) => r.status === 200).map((r) => r.body._id);
    expect(ids).toHaveLength(3);
    expect(new Set(ids).size).toBe(3);
  });
});
@@@ solution/src/queue.js
const db = require('memdb');
const clock = require('./clock');

const jobs = db.collection('jobs');
const LEASE_MS = 30 * 1000;
let seq = 0;

async function enqueue(type) {
  return jobs.insert({ type, seq: ++seq, status: 'queued', worker: null, leaseUntil: null });
}

// memdb matches in insertion order, so the first match is the oldest job.
async function claim(worker) {
  const now = clock.now();
  const patch = { $set: { status: 'running', worker, leaseUntil: now + LEASE_MS } };
  return (await jobs.findOneAndUpdate({ status: 'queued' }, patch))
    || jobs.findOneAndUpdate({ status: 'running', leaseUntil: { $lte: now } }, patch);
}

async function complete(worker, id) {
  return jobs.findOneAndUpdate({ _id: id, worker, status: 'running' }, { $set: { status: 'done' } });
}

module.exports = { enqueue, claim, complete };
