@@@ repo/src/comments.js
const all = require('./data');

function forPost(postId) {
  return all
    .filter((c) => c.postId === postId)
    .sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
}

module.exports = { forPost };
@@@ repo/src/app.js
const express = require('express');
const { forPost } = require('./comments');

const app = express();

app.get('/posts/:postId/comments', (req, res) => {
  const { author } = req.query;
  const list = forPost(req.params.postId);
  const total = list.length;
  const comments = author ? list.filter((c) => c.authorId === author) : list;
  res.json({ total, comments });
});

module.exports = app;
@@@ repo/tests/comments.test.js
const request = require('supertest');
const app = require('../src/app');

const ids = (res) => res.body.comments.map((c) => c.id);

describe('Comments', () => {
  test('newest first', async () => {
    const res = await request(app).get('/posts/p1/comments');
    expect(ids(res)).toEqual(['c4', 'c3', 'c1', 'c2']);
    expect(res.body.total).toBe(4);
  });
  test('authorId filter + total', async () => {
    const res = await request(app).get('/posts/p1/comments?authorId=a');
    expect(ids(res)).toEqual(['c3', 'c1']);
    expect(res.body.total).toBe(2);
  });
});
