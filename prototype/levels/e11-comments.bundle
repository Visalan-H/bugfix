@@@ solution/src/comments.js
const all = require('./data');

// "DD/MM/YYYY HH:mm" (UTC) → epoch ms
function ts(s) {
  const [d, m, y, hh, mm] = s.split(/[/ :]/).map(Number);
  return Date.UTC(y, m - 1, d, hh, mm);
}

function forPost(postId) {
  return all
    .filter((c) => c.postId === postId)
    .sort((a, b) => ts(b.createdAt) - ts(a.createdAt));
}

module.exports = { forPost };
@@@ solution/src/app.js
const express = require('express');
const { forPost } = require('./comments');

const app = express();

app.get('/posts/:postId/comments', (req, res) => {
  const { authorId } = req.query;
  const list = forPost(req.params.postId);
  const comments = authorId ? list.filter((c) => c.authorId === authorId) : list;
  res.json({ total: comments.length, comments });
});

module.exports = app;
