@@@ ticket.md
# LNK-7: Short links misbehave

| Method | Path | Behaviour |
|---|---|---|
| `POST` | `/links` `{ url }` | **201** `{ code, url }`. `code` is **6** chars. `url` must start with http(s):// → else **400** |
| `GET` | `/:code` | **302** redirect to the url and count a visit. Unknown → **404** |
| `GET` | `/links/:code/stats` | `{ code, visits }` |
@@@ repo/package.json
{ "name": "shortener", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/app.js
const express = require('express');
const repo = require('./linkRepo');
const { newCode } = require('./codes');

const app = express();
app.use(express.json());

app.post('/links', async (req, res) => {
  const { url } = req.body;
  if (!/^https?:\/\//.test(url || '')) return res.status(400).json({ error: 'invalid url' });
  const link = await repo.create({ code: newCode(), url, visits: 0 });
  res.status(201).json({ code: link.code, url: link.url });
});

app.get('/links/:code/stats', async (req, res) => {
  const link = await repo.findByCode(req.params.code);
  if (!link) return res.status(404).json({ error: 'not found' });
  res.json({ code: link.code, visits: link.visits });
});

app.get('/:code', async (req, res) => {
  const link = repo.findByCode(req.params.code);
  if (!link) return res.status(404).json({ error: 'not found' });
  link.visits++;
  res.redirect(301, link.url);
});

module.exports = app;
@@@ repo/src/linkRepo.js
const db = require('memdb');
const links = db.collection('links');

exports.create = (doc) => links.insert(doc);
exports.findByCode = (code) => links.findOne({ code });
exports.incrementVisits = (id) => links.findOneAndUpdate({ _id: id }, { $inc: { visits: 1 } });
@@@ repo/src/codes.js
exports.newCode = () => Math.random().toString(36).slice(2, 6).padEnd(4, '0');
@@@ repo/tests/links.test.js
const request = require('supertest');
const app = require('../src/app');

const shorten = (url) => request(app).post('/links').send({ url });

describe('Shortener', () => {
  test('redirects with 302', async () => {
    const { body } = await shorten('https://amazon.jobs');
    const res = await request(app).get(`/${body.code}`);
    expect(res.status).toBe(302);
    expect(res.headers.location).toBe('https://amazon.jobs');
  });

  test('unknown code → 404', async () => {
    const res = await request(app).get('/nope99');
    expect(res.status).toBe(404);
  });

  test('visits are counted', async () => {
    const { body } = await shorten('https://example.com');
    await request(app).get(`/${body.code}`);
    await request(app).get(`/${body.code}`);
    const stats = await request(app).get(`/links/${body.code}/stats`);
    expect(stats.body.visits).toBe(2);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

describe('hidden', () => {
  test('codes are 6 characters', async () => {
    const res = await request(app).post('/links').send({ url: 'https://a.b' });
    expect(res.body.code).toHaveLength(6);
  });
  test('invalid url → 400', async () => {
    expect((await request(app).post('/links').send({ url: 'ftp://x' })).status).toBe(400);
    expect((await request(app).post('/links').send({})).status).toBe(400);
  });
  test('stats for unknown code → 404', async () => {
    expect((await request(app).get('/links/zzzzzz/stats')).status).toBe(404);
  });
  test('a 404 does not create visits anywhere', async () => {
    const { body } = await request(app).post('/links').send({ url: 'https://x.y' });
    await request(app).get('/missing1');
    expect((await request(app).get(`/links/${body.code}/stats`)).body.visits).toBe(0);
  });
});
@@@ solution/src/app.js
const express = require('express');
const repo = require('./linkRepo');
const { newCode } = require('./codes');

const app = express();
app.use(express.json());

app.post('/links', async (req, res) => {
  const { url } = req.body;
  if (!/^https?:\/\//.test(url || '')) return res.status(400).json({ error: 'invalid url' });
  const link = await repo.create({ code: newCode(), url, visits: 0 });
  res.status(201).json({ code: link.code, url: link.url });
});

app.get('/links/:code/stats', async (req, res) => {
  const link = await repo.findByCode(req.params.code);
  if (!link) return res.status(404).json({ error: 'not found' });
  res.json({ code: link.code, visits: link.visits });
});

app.get('/:code', async (req, res) => {
  const link = await repo.findByCode(req.params.code);
  if (!link) return res.status(404).json({ error: 'not found' });
  await repo.incrementVisits(link._id);
  res.redirect(302, link.url);
});

module.exports = app;
@@@ solution/src/codes.js
exports.newCode = () => Math.random().toString(36).slice(2, 8).padEnd(6, '0');
