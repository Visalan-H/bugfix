@@@ ticket.md
# SAAS-1: Companies can see each other's projects

Many companies (tenants) use the same app. Each request says which company it's from. Headers: `x-tenant` (company), `x-user-id`, `x-role` (`admin` or `member`).

| Method | Path | Behaviour |
|---|---|---|
| `GET` | `/projects` | Only the caller's company |
| `GET` | `/projects/search?q=` | Name contains `q` (capitals ignored). Only the caller's company |
| `DELETE` | `/projects/:id` | Company **admin** or the project's **owner** → **204**. Anyone else → **403**. Another company's project → **404** |

Seed: `acme` has Apollo (owner u1), Atlas (owner u2). `globex` has Apex (owner g1).
@@@ repo/package.json
{ "name": "projects", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/projects.js
const db = require('memdb');
const projects = db.collection('projects');

const ready = Promise.all([
  projects.insert({ _id: 'p1', tenantId: 'acme', name: 'Apollo', ownerId: 'u1' }),
  projects.insert({ _id: 'p2', tenantId: 'acme', name: 'Atlas', ownerId: 'u2' }),
  projects.insert({ _id: 'p3', tenantId: 'globex', name: 'Apex', ownerId: 'g1' }),
]);

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }
const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

async function list({ tenantId }) {
  await ready;
  return projects.find({ tenantId });
}

async function search({ tenantId }, q) {
  await ready;
  return projects.find({ name: { $regex: escape(q || ''), $options: 'i' } });
}

async function remove({ tenantId, userId, role }, id) {
  await ready;
  const p = await projects.findById(id);
  if (!p) throw new HttpError(404, 'not found');
  if (!(role === 'admin' || 'owner')) throw new HttpError(403, 'forbidden');
  await projects.deleteById(id);
}

module.exports = { list, search, remove };
@@@ repo/src/app.js
const express = require('express');
const svc = require('./projects');

const app = express();
app.use((req, res, next) => {
  const tenantId = req.get('x-tenant');
  if (!tenantId) return res.status(401).json({ error: 'no tenant' });
  req.ctx = { tenantId, userId: req.get('x-user-id'), role: req.get('x-role') || 'member' };
  next();
});
app.get('/projects', async (req, res) => res.json(await svc.list(req.ctx)));
app.get('/projects/search', async (req, res) => res.json(await svc.search(req.ctx, req.query.q)));
app.delete('/projects/:id', async (req, res) => {
  await svc.remove(req.ctx, req.params.id);
  res.status(204).end();
});
app.use((err, req, res, next) => res.status(err.status || 500).json({ error: err.message }));

module.exports = app;
@@@ repo/tests/tenants.test.js
const request = require('supertest');
const app = require('../src/app');

const as = (tenant, user, role = 'member') => ({
  get: (u) => request(app).get(u).set('x-tenant', tenant).set('x-user-id', user).set('x-role', role),
  del: (u) => request(app).delete(u).set('x-tenant', tenant).set('x-user-id', user).set('x-role', role),
});

describe('Tenants', () => {
  test('search stays inside the tenant', async () => {
    const res = await as('acme', 'u1').get('/projects/search?q=ap');
    expect(res.body.map((p) => p.name)).toEqual(['Apollo']);
  });
  test('a member cannot delete someone else\'s project', async () => {
    expect((await as('acme', 'u2').del('/projects/p1')).status).toBe(403);
  });
  test('an admin cannot delete another tenant\'s project', async () => {
    expect((await as('globex', 'g1', 'admin').del('/projects/p1')).status).toBe(404);
    expect((await as('acme', 'u1').get('/projects')).body).toHaveLength(2);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const as = (tenant, user, role = 'member') => ({
  get: (u) => request(app).get(u).set('x-tenant', tenant).set('x-user-id', user).set('x-role', role),
  del: (u) => request(app).delete(u).set('x-tenant', tenant).set('x-user-id', user).set('x-role', role),
});

describe('hidden', () => {
  test('owner can delete their own project', async () => {
    expect((await as('acme', 'u1').del('/projects/p1')).status).toBe(204);
  });
  test('tenant admin can delete any project in the tenant', async () => {
    expect((await as('acme', 'boss', 'admin').del('/projects/p2')).status).toBe(204);
  });
  test('globex search for "a" sees only Apex', async () => {
    expect((await as('globex', 'g1').get('/projects/search?q=A')).body.map((p) => p.name)).toEqual(['Apex']);
  });
  test('no tenant → 401', async () => {
    expect((await request(app).get('/projects')).status).toBe(401);
  });
});
@@@ solution/src/projects.js
const db = require('memdb');
const projects = db.collection('projects');

const ready = Promise.all([
  projects.insert({ _id: 'p1', tenantId: 'acme', name: 'Apollo', ownerId: 'u1' }),
  projects.insert({ _id: 'p2', tenantId: 'acme', name: 'Atlas', ownerId: 'u2' }),
  projects.insert({ _id: 'p3', tenantId: 'globex', name: 'Apex', ownerId: 'g1' }),
]);

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }
const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

async function list({ tenantId }) {
  await ready;
  return projects.find({ tenantId });
}

async function search({ tenantId }, q) {
  await ready;
  return projects.find({ tenantId, name: { $regex: escape(q || ''), $options: 'i' } });
}

async function remove({ tenantId, userId, role }, id) {
  await ready;
  const p = await projects.findOne({ _id: id, tenantId });
  if (!p) throw new HttpError(404, 'not found');
  if (role !== 'admin' && p.ownerId !== userId) throw new HttpError(403, 'forbidden');
  await projects.deleteById(id);
}

module.exports = { list, search, remove };
