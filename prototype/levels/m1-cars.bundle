const ctrl = require('../controllers/carController');

const router = express.Router();

router.get('/mine', ctrl.listMine);
router.post('/', ctrl.create);
router.get('/:id', ctrl.getOne);
router.patch('/:id', ctrl.update);

module.exports = router;
@@@ repo/src/controllers/carController.js
const carService = require('../services/carService');

exports.listMine = async (req, res) => {
  const cars = await carService.listMine(req.user.userId);
  res.json(cars);
};

exports.create = async (req, res) => {
  const { model, dailyRate } = req.body;
  if (!model || typeof dailyRate !== 'number' || dailyRate <= 0) {
    return res.status(400).json({ error: 'model and positive dailyRate are required' });
  }
  const car = await carService.addCar(req.user.id, { model, dailyRate });
  res.status(201).json(car);
};

exports.getOne = async (req, res) => {
  const car = await carService.getCar(req.params.id);
  if (!car) return res.status(404).json({ error: 'car not found' });
  res.json(car);
};

exports.update = async (req, res) => {
  const car = await carService.updateCar(req.user.id, req.params.id, req.body);
  if (!car) return res.status(404).json({ error: 'car not found' });
  res.json(car);
};
@@@ repo/src/services/carService.js
const carRepo = require('../repositories/carRepo');
const cache = require('../lib/cache');

const EDITABLE = ['model', 'dailyRate'];
const key = (ownerId) => `cars:${ownerId}`;

function pick(obj, fields) {
  const out = {};
  for (const f of fields) if (obj[f] !== undefined) out[f] = obj[f];
  return out;
}

function invalidate(ownerId) {
  cache.del(key(ownerId));
}

async function listMine(ownerId) {
  const cached = cache.get(key(ownerId));
  if (cached) return cached;
  const cars = await carRepo.findByOwner(ownerId);
  cache.set(key(ownerId), cars);
  return cars;
}

async function addCar(ownerId, { model, dailyRate }) {
  const car = await carRepo.insert({ owner: ownerId, model, dailyRate });
  return car;
}

async function getCar(carId) {
  return carRepo.findById(carId);
}

async function updateCar(ownerId, carId, changes) {
  const car = await carRepo.findById(carId);
  if (!car || car.owner !== ownerId) return null;

  Object.assign(car, pick(changes, EDITABLE));
  invalidate(ownerId);
  return car;
}

module.exports = { listMine, addCar, getCar, updateCar };
@@@ repo/src/repositories/carRepo.js
const db = require('memdb');
const cars = db.collection('cars');

exports.findByOwner = (owner) => cars.find({ owner });
exports.findById = (id) => cars.findById(id);
exports.insert = (doc) => cars.insert(doc);
exports.update = (id, patch) => cars.updateById(id, patch);
@@@ repo/src/lib/cache.js
const store = new Map();

module.exports = {
  get: (k) => store.get(k),
  set: (k, v) => store.set(k, v),
  del: (k) => store.delete(k),
};
@@@ repo/tests/cars.test.js
const request = require('supertest');
const app = require('../src/app');

const as = (user) => ({
  get: (url) => request(app).get(url).set('x-user-id', user),
  post: (url, body) => request(app).post(url).set('x-user-id', user).send(body),
  patch: (url, body) => request(app).patch(url).set('x-user-id', user).send(body),
});
const alice = as('alice');
const bob = as('bob');

describe('My Garage', () => {
  test('GET /cars/mine only returns my cars', async () => {
    await alice.post('/cars', { model: 'Swift', dailyRate: 1800 });
    await bob.post('/cars', { model: 'Creta', dailyRate: 3200 });

    const res = await alice.get('/cars/mine');
    expect(res.status).toBe(200);
    expect(res.body).toHaveLength(1);
    expect(res.body[0].owner).toBe('alice');
  });

  test('a newly added car shows up in My Cars', async () => {
    const before = await alice.get('/cars/mine');
    expect(before.body).toHaveLength(0);

    await alice.post('/cars', { model: 'Nexon', dailyRate: 2500 });
    const after = await alice.get('/cars/mine');
    expect(after.body).toHaveLength(1);
    expect(after.body[0].model).toBe('Nexon');
  });

  test('an edit is persisted', async () => {
    const created = await alice.post('/cars', { model: 'i20', dailyRate: 2000 });
    const id = created.body._id;

    const patched = await alice.patch(`/cars/${id}`, { dailyRate: 2400 });
    expect(patched.status).toBe(200);
    expect(patched.body.dailyRate).toBe(2400);

    const fresh = await alice.get(`/cars/${id}`);
    expect(fresh.body.dailyRate).toBe(2400);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const as = (user) => ({
  get: (url) => request(app).get(url).set('x-user-id', user),
  post: (url, body) => request(app).post(url).set('x-user-id', user).send(body),
  patch: (url, body) => request(app).patch(url).set('x-user-id', user).send(body),
});
const alice = as('alice');
const bob = as('bob');

describe('hidden', () => {
  test('cannot read another user\'s car by id', async () => {
    const c = await bob.post('/cars', { model: 'Thar', dailyRate: 4000 });
    const res = await alice.get(`/cars/${c.body._id}`);
    expect(res.status).toBe(404);
  });

  test('cannot edit another user\'s car', async () => {
    const c = await bob.post('/cars', { model: 'Thar', dailyRate: 4000 });
    const res = await alice.patch(`/cars/${c.body._id}`, { dailyRate: 1 });
    expect(res.status).toBe(404);
    const still = await bob.get(`/cars/${c.body._id}`);
    expect(still.body.dailyRate).toBe(4000);
  });

  test('edit shows up in My Cars (cache invalidated on update)', async () => {
    const c = await alice.post('/cars', { model: 'City', dailyRate: 2200 });
    await alice.get('/cars/mine');
    await alice.patch(`/cars/${c.body._id}`, { dailyRate: 2600 });
    const list = await alice.get('/cars/mine');
    expect(list.body[0].dailyRate).toBe(2600);
  });

  test('owner cannot be changed through PATCH', async () => {
    const c = await alice.post('/cars', { model: 'City', dailyRate: 2200 });
    await alice.patch(`/cars/${c.body._id}`, { owner: 'bob' });
    const res = await alice.get(`/cars/${c.body._id}`);
    expect(res.body.owner).toBe('alice');
  });

  test('missing x-user-id is 401', async () => {
    const res = await request(app).get('/cars/mine');
    expect(res.status).toBe(401);
  });
});
