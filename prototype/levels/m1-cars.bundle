@@@ repo/README.md
# car-rental-api

Layers: `routes → controllers → services → repositories → memdb`

* `memdb` behaves like Mongoose: async calls, returns **copies**, and **drops `undefined` keys from filters**.
* `src/lib/cache.js` is a per-process in-memory cache.
@@@ repo/src/app.js
const express = require('express');
const auth = require('./middleware/auth');
const carRoutes = require('./routes/cars');

const app = express();
app.use(express.json());
app.use(auth);
app.use('/cars', carRoutes);

module.exports = app;
@@@ repo/src/middleware/auth.js
// In prod this verifies a JWT. For the exercise the gateway passes the user id in a header.
module.exports = function auth(req, res, next) {
  const userId = req.get('x-user-id');
  if (!userId) {
    return res.status(401).json({ error: 'unauthenticated' });
  }
  req.user = { id: userId };
  next();
};
@@@ repo/src/routes/cars.js
