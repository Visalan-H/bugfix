module.exports = function errorHandler(err, req, res, next) {
  const status = err.status || 500;
  if (status === 500) console.error(err);
  res.status(status).json({ error: err.message });
};
@@@ repo/src/routes/auth.js
const express = require('express');
const service = require('../services/resetService');

const router = express.Router();

router.post('/forgot', async (req, res) => {
  await service.requestReset(req.body.email);
  res.status(202).json({ ok: true });
});

router.post('/reset', async (req, res) => {
  await service.resetPassword(req.body.token, req.body.newPassword);
  res.json({ ok: true });
});

router.post('/login', async (req, res) => {
  await service.login(req.body.email, req.body.password);
  res.json({ ok: true });
});

module.exports = router;
@@@ repo/src/services/resetService.js
const users = require('../repositories/userRepo');
const resets = require('../repositories/resetRepo');
const clock = require('../lib/clock');
const tokens = require('../lib/tokens');
const outbox = require('../lib/outbox');
const { ValidationError, AuthError } = require('../errors');

const TTL_MINUTES = 15;
const MIN_PASSWORD = 8;

async function requestReset(email) {
  const user = await users.findByEmail(email);
  if (!user) return; // don't reveal which emails exist

  const token = tokens.generate();
  await resets.create({ token, userId: user._id, expiresAt: clock.now() + TTL_MINUTES * 60, used: false });
  outbox.send({ to: user.email, template: 'password-reset', token });
}

async function resetPassword(token, newPassword) {
  if (!newPassword || newPassword.length <= MIN_PASSWORD) {
    throw new ValidationError(`password must be at least ${MIN_PASSWORD} characters`);
  }
  const record = await resets.findByToken(token);
  if (!record || record.used || record.expiresAt < clock.now()) {
    throw new ValidationError('invalid or expired token');
  }
  await users.setPassword(record.userId, newPassword);
  record.used = true;
}

async function login(email, password) {
  const user = await users.findByEmail(email);
  if (!user || user.password !== password) throw new AuthError();
}

module.exports = { requestReset, resetPassword, login };
@@@ repo/src/repositories/userRepo.js
const db = require('memdb');
const users = db.collection('users');

const ready = Promise.all([
  users.insert({ email: 'asha@example.com', password: 'old-password' }),
  users.insert({ email: 'ravi@example.com', password: 'ravi-secret' }),
]);

exports.findByEmail = async (email) => {
  await ready;
  return users.findOne({ email });
};

exports.setPassword = async (id, password) => {
  await ready;
  return users.updateById(id, { password });
};
@@@ repo/src/repositories/resetRepo.js
const db = require('memdb');
const resets = db.collection('password_resets');

exports.create = (doc) => resets.insert(doc);
exports.findByToken = (token) => resets.findOne({ token });
exports.markUsed = (id) => resets.updateById(id, { used: true });
@@@ repo/src/lib/clock.js
let offset = 0;

module.exports = {
  now: () => Date.now() + offset,
  advance: (ms) => { offset += ms; },
};
@@@ repo/src/lib/tokens.js
let n = 0;
exports.generate = () => `rst_${++n}_${Math.random().toString(36).slice(2, 10)}`;
@@@ repo/src/lib/outbox.js
const sent = [];

module.exports = {
  send: (mail) => { sent.push(mail); },
  sent,
};
@@@ repo/tests/reset.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/lib/clock');
const outbox = require('../src/lib/outbox');

const post = (url, body) => request(app).post(url).send(body);
const MIN = 60 * 1000;

describe('Password reset', () => {
  test('email lookup ignores case', async () => {
    const res = await post('/auth/forgot', { email: 'Asha@Example.com' });
    expect(res.status).toBe(202);
    expect(outbox.sent).toHaveLength(1);
    expect(outbox.sent[0].to).toBe('asha@example.com');
  });

  test('token still works 10 minutes later, and the new password logs in', async () => {
    await post('/auth/forgot', { email: 'asha@example.com' });
    const { token } = outbox.sent[0];
    clock.advance(10 * MIN);

    const res = await post('/auth/reset', { token, newPassword: 'brand-new-pass' });
    expect(res.status).toBe(200);
    expect((await post('/auth/login', { email: 'asha@example.com', password: 'brand-new-pass' })).status).toBe(200);
    expect((await post('/auth/login', { email: 'asha@example.com', password: 'old-password' })).status).toBe(401);
  });

  test('a token can only be used once', async () => {
    await post('/auth/forgot', { email: 'ravi@example.com' });
    const { token } = outbox.sent[0];
    expect((await post('/auth/reset', { token, newPassword: 'first-new-pass' })).status).toBe(200);
    const again = await post('/auth/reset', { token, newPassword: 'attacker-pass' });
    expect(again.status).toBe(400);
  });

  test('token expires after 15 minutes', async () => {
    await post('/auth/forgot', { email: 'asha@example.com' });
    const { token } = outbox.sent[0];
    clock.advance(16 * MIN);
    const res = await post('/auth/reset', { token, newPassword: 'too-late-pass' });
    expect(res.status).toBe(400);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');
const outbox = require('../src/lib/outbox');

const post = (url, body) => request(app).post(url).send(body);

describe('hidden', () => {
  test('unknown email: still 202, nothing sent', async () => {
    const res = await post('/auth/forgot', { email: 'nobody@example.com' });
    expect(res.status).toBe(202);
    expect(outbox.sent).toHaveLength(0);
  });

  test('exactly 8 characters is accepted', async () => {
    await post('/auth/forgot', { email: 'asha@example.com' });
    const res = await post('/auth/reset', { token: outbox.sent[0].token, newPassword: '12345678' });
    expect(res.status).toBe(200);
  });

  test('7 characters is rejected', async () => {
    await post('/auth/forgot', { email: 'asha@example.com' });
    const res = await post('/auth/reset', { token: outbox.sent[0].token, newPassword: '1234567' });
    expect(res.status).toBe(400);
  });

  test('garbage token → 400', async () => {
    const res = await post('/auth/reset', { token: 'nope', newPassword: 'long-enough-pass' });
    expect(res.status).toBe(400);
  });

  test('padded email works for forgot and login', async () => {
    await post('/auth/forgot', { email: '  RAVI@example.com ' });
    expect(outbox.sent).toHaveLength(1);
    const res = await post('/auth/login', { email: ' Ravi@Example.com', password: 'ravi-secret' });
    expect(res.status).toBe(200);
  });
});
