@@@ repo/src/app.js
const express = require('express');
const auth = require('./middleware/auth');
const rateLimit = require('./middleware/rateLimit');

const app = express();
app.use(express.json());
app.use(auth);

app.get('/api/quote', rateLimit({ limit: 5, windowMs: 60 * 1000 }), (req, res) => {
  res.json({ quote: 'Ship small, ship often.', client: req.get('x-api-key') });
});

module.exports = app;
@@@ repo/src/middleware/auth.js
module.exports = function auth(req, res, next) {
  if (!req.get('x-api-key')) {
    return res.status(401).json({ error: 'missing api key' });
  }
  next();
};
@@@ repo/src/middleware/rateLimit.js
const clock = require('../lib/clock');

// Sliding-window limiter. In prod this state lives in Redis.
module.exports = function rateLimit({ limit, windowMs }) {
  const buckets = new Map(); // key -> [timestamps]

  return function rateLimitMiddleware(req, res, next) {
    const key = req.headers['X-Api-Key'];
    const now = clock.now();

    const hits = (buckets.get(key) || []).filter((t) => t < now - windowMs);
    hits.push(now);
    buckets.set(key, hits);

    if (hits.length > limit) {
      const retryAfter = hits[0] + windowMs - now;
      res.set('Retry-After', String(retryAfter));
      return res.status(429).json({ error: 'rate limit exceeded' });
    }
    next();
  };
};
@@@ repo/src/lib/clock.js
// Frozen clock: only moves when tests advance it.
let t = Date.UTC(2026, 0, 1, 0, 0, 0);

module.exports = {
  now: () => t,
  advance: (ms) => { t += ms; },
};
@@@ repo/tests/rateLimit.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/lib/clock');

const hit = (key) => request(app).get('/api/quote').set('x-api-key', key);
const burst = async (key, n) => { const out = []; for (let i = 0; i < n; i++) out.push((await hit(key)).status); return out; };

describe('Rate limiter', () => {
  test('5 requests pass, the 6th is 429', async () => {
    expect(await burst('k1', 6)).toEqual([200, 200, 200, 200, 200, 429]);
  });

  test('limits are per API key', async () => {
    await burst('k1', 6);
    const other = await hit('k2');
    expect(other.status).toBe(200);
  });

  test('allowed again after the window passes', async () => {
    await burst('k1', 5);
    clock.advance(60 * 1000);
    expect((await hit('k1')).status).toBe(200);
  });

  test('Retry-After is in seconds', async () => {
    await burst('k1', 5);
    clock.advance(20 * 1000);
    const res = await hit('k1');
    expect(res.status).toBe(429);
    expect(res.headers['retry-after']).toBe('40');
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');
const clock = require('../src/lib/clock');

const hit = (key) => request(app).get('/api/quote').set('x-api-key', key);
const burst = async (key, n) => { const out = []; for (let i = 0; i < n; i++) out.push((await hit(key)).status); return out; };

describe('hidden', () => {
  test('missing key → 401', async () => {
    const res = await request(app).get('/api/quote');
    expect(res.status).toBe(401);
  });

  test('rejected requests do not extend the block', async () => {
    await burst('k', 5);
    clock.advance(30 * 1000);
    expect(await burst('k', 5)).toEqual([429, 429, 429, 429, 429]);
    clock.advance(31 * 1000);
    expect((await hit('k')).status).toBe(200);
  });

  test('Retry-After rounds up', async () => {
    await burst('k', 5);
    clock.advance(19500);
    const res = await hit('k');
    expect(res.headers['retry-after']).toBe('41');
  });

  test('sliding window: old hits roll off one by one', async () => {
    await hit('k');
    clock.advance(10 * 1000);
    await burst('k', 4);
    expect((await hit('k')).status).toBe(429);
    clock.advance(50 * 1000);
    expect((await hit('k')).status).toBe(200);
    expect((await hit('k')).status).toBe(429);
  });
});
@@@ solution/src/middleware/rateLimit.js
const clock = require('../lib/clock');

// Sliding-window limiter. In prod this state lives in Redis.
module.exports = function rateLimit({ limit, windowMs }) {
  const buckets = new Map(); // key -> [timestamps]

  return function rateLimitMiddleware(req, res, next) {
    const key = req.get('x-api-key');
    const now = clock.now();

    const hits = (buckets.get(key) || []).filter((t) => t > now - windowMs);
    buckets.set(key, hits);

    if (hits.length >= limit) {
      const retryAfter = Math.ceil((hits[0] + windowMs - now) / 1000);
      res.set('Retry-After', String(retryAfter));
      return res.status(429).json({ error: 'rate limit exceeded' });
    }
    hits.push(now);
    next();
  };
};
