@@@ repo/src/rollup.js
const sessions = require('./sessions');

const dayKey = (ts) => {
  const d = new Date(ts);
  return `${d.getUTCFullYear()}-${d.getUTCMonth() + 1}-${d.getUTCDate()}`;
};

function daily(from, to) {
  const start = Date.parse(from);
  const end = Date.parse(to);
  const inRange = sessions.filter((s) => s.ts >= start && s.ts < end);

  const byDay = {};
  for (const s of inRange) {
    const k = dayKey(s.ts);
    (byDay[k] = byDay[k] || []).push(s.durationSec);
  }

  const days = Object.keys(byDay).sort().map((day) => {
    const list = byDay[day];
    return { day, sessions: list.length, avgSec: Math.round(list.reduce((a, b) => a + b, 0) / list.length) };
  });

  const overallAvgSec = days.length ? Math.round(days.reduce((a, d) => a + d.avgSec, 0) / days.length) : 0;
  return { days, overallAvgSec };
}

module.exports = { daily };
@@@ repo/src/app.js
const express = require('express');
const { daily } = require('./rollup');

const app = express();
app.get('/stats/daily', (req, res) => res.json(daily(req.query.from, req.query.to)));

module.exports = app;
@@@ repo/tests/rollup.test.js
const request = require('supertest');
const app = require('../src/app');

const stats = (from, to) => request(app).get(`/stats/daily?from=${from}&to=${to}`);

describe('Daily rollup', () => {
  test('padded keys, in order', async () => {
    const res = await stats('2026-03-08', '2026-03-12');
    expect(res.body.days.map((d) => d.day)).toEqual(['2026-03-08', '2026-03-09', '2026-03-10', '2026-03-11', '2026-03-12']);
  });
  test('empty days are filled with zeros', async () => {
    const res = await stats('2026-03-09', '2026-03-11');
    expect(res.body.days).toEqual([
      { day: '2026-03-09', sessions: 3, avgSec: 20 },
      { day: '2026-03-10', sessions: 0, avgSec: 0 },
      { day: '2026-03-11', sessions: 1, avgSec: 50 },
    ]);
  });
  test('the to-day is included', async () => {
    const res = await stats('2026-03-12', '2026-03-12');
    expect(res.body.days).toEqual([{ day: '2026-03-12', sessions: 1, avgSec: 70 }]);
  });
});
