@@@ repo/src/inventory.js
// Imported from the supplier CSV. Every value is a string.
module.exports = [
  { sku: 'A', name: 'Bubble wrap', stock: '9' },
  { sku: 'B', name: 'Tape', stock: '12' },
  { sku: 'C', name: 'Boxes (S)', stock: '100' },
  { sku: 'D', name: 'Boxes (L)', stock: '0' },
  { sku: 'E', name: 'Labels', stock: '3' },
  { sku: 'F', name: 'Markers', stock: '10' },
];
@@@ repo/src/report.js
const inventory = require('./inventory');

const DEFAULT = 5;

function lowStock(rawThreshold) {
  const threshold = Number(rawThreshold) || DEFAULT;
  const items = inventory
    .filter((i) => i.stock <= String(threshold))
    .sort((a, b) => a.stock - b.stock);
  const totalUnits = items.reduce((s, i) => s + i.stock, 0);
  return { items, totalUnits };
}

module.exports = { lowStock };
@@@ repo/src/app.js
const express = require('express');
const { lowStock } = require('./report');

const app = express();
app.get('/reports/low-stock', (req, res) => res.json(lowStock(req.query.threshold)));

module.exports = app;
@@@ repo/tests/report.test.js
const request = require('supertest');
const app = require('../src/app');

const skus = (res) => res.body.items.map((i) => i.sku);

describe('Low stock', () => {
  test('threshold=10', async () => {
    const res = await request(app).get('/reports/low-stock?threshold=10');
    expect(skus(res)).toEqual(['D', 'E', 'A', 'F']);
    expect(res.body.totalUnits).toBe(22);
  });
  test('default threshold 5', async () => {
    const res = await request(app).get('/reports/low-stock');
    expect(skus(res)).toEqual(['D', 'E']);
    expect(res.body.totalUnits).toBe(3);
  });
  test('threshold=0 → only out of stock', async () => {
    const res = await request(app).get('/reports/low-stock?threshold=0');
    expect(skus(res)).toEqual(['D']);
  });
});
