@@@ ticket.md
# KIDS-2: Family profiles validation

`POST /profiles { name, age, email, tags? }` → **201** or **400** `{ errors: [...] }`

* `name`: non-empty after trim
* `age`: **integer 0–120** (0 is valid: infant profiles exist)
* `email`: the whole value must look like `x@y.z` (no spaces)
* `tags`: optional; if present, an array of **at most 5 strings**
@@@ repo/package.json
{ "name": "profiles", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/validate.js
const EMAIL = /[^@\s]+@[^@\s]+\.[^@\s]+/;

function validateProfile({ name, age, email, tags }) {
  const errors = [];
  if (!name || !String(name).trim()) errors.push('name is required');
  if (!age || age < 0 || age > 120) errors.push('age must be an integer 0-120');
  if (!EMAIL.test(email || '')) errors.push('email is invalid');
  if (tags !== undefined && (typeof tags !== 'array' || tags.length > 5)) errors.push('tags must be up to 5 strings');
  return errors;
}

module.exports = { validateProfile };
@@@ repo/src/app.js
const express = require('express');
const { validateProfile } = require('./validate');

const app = express();
app.use(express.json());

app.post('/profiles', (req, res) => {
  const errors = validateProfile(req.body);
  if (errors.length) return res.status(400).json({ errors });
  res.status(201).json({ ok: true, profile: req.body });
});

module.exports = app;
@@@ repo/tests/validate.test.js
const request = require('supertest');
const app = require('../src/app');

const post = (body) => request(app).post('/profiles').send(body);
const ok = { name: 'Kavin', age: 30, email: 'kavin@example.com' };

describe('Profile validation', () => {
  test('age 0 is valid', async () => {
    expect((await post({ ...ok, age: 0 })).status).toBe(201);
  });
  test('tags array is accepted', async () => {
    expect((await post({ ...ok, tags: ['family', 'admin'] })).status).toBe(201);
  });
  test('email must be the whole value', async () => {
    expect((await post({ ...ok, email: 'hello a@b.co' })).status).toBe(400);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const post = (body) => request(app).post('/profiles').send(body);
const ok = { name: 'Kavin', age: 30, email: 'kavin@example.com' };

describe('hidden', () => {
  test('25.5 is not an integer', async () => { expect((await post({ ...ok, age: 25.5 })).status).toBe(400); });
  test('6 tags → 400', async () => { expect((await post({ ...ok, tags: ['a', 'b', 'c', 'd', 'e', 'f'] })).status).toBe(400); });
  test('non-string tag → 400', async () => { expect((await post({ ...ok, tags: ['a', 5] })).status).toBe(400); });
  test('tags as a string → 400', async () => { expect((await post({ ...ok, tags: 'abc' })).status).toBe(400); });
  test('blank name → 400', async () => { expect((await post({ ...ok, name: '   ' })).status).toBe(400); });
  test('age 121 → 400, 120 ok', async () => {
    expect((await post({ ...ok, age: 121 })).status).toBe(400);
    expect((await post({ ...ok, age: 120 })).status).toBe(201);
  });
});
@@@ solution/src/validate.js
const EMAIL = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

function validateProfile({ name, age, email, tags }) {
  const errors = [];
  if (!name || !String(name).trim()) errors.push('name is required');
  if (!Number.isInteger(age) || age < 0 || age > 120) errors.push('age must be an integer 0-120');
  if (!EMAIL.test(email || '')) errors.push('email is invalid');
  if (tags !== undefined && (!Array.isArray(tags) || tags.length > 5 || !tags.every((t) => typeof t === 'string'))) {
    errors.push('tags must be up to 5 strings');
  }
  return errors;
}

module.exports = { validateProfile };
