@@@ repo/src/csv.js
function parseLine(line) {
  return line.split(',').map((f) => f.trim());
}

module.exports = { parseLine };
@@@ repo/src/importer.js
const db = require('memdb');
const { parseLine } = require('./csv');

const customers = db.collection('customers');

async function importCsv(text) {
  const [header, ...rows] = String(text).split('\n');
  const result = { imported: 0, skipped: 0, errors: [] };

  for (let i = 0; i < rows.length; i++) {
    const [name, email, rawAmount] = parseLine(rows[i]);
    if (!name || !email || !email.includes('@')) {
      result.errors.push({ line: i, reason: 'name and a valid email are required' });
      continue;
    }
    const amount = parseInt(rawAmount, 10);
    if (Number.isNaN(amount)) {
      result.errors.push({ line: i, reason: 'amount is not a number' });
      continue;
    }
    await customers.insert({ name, email: email.toLowerCase(), amount });
    result.imported++;
  }
  return result;
}

module.exports = { importCsv, customers };
@@@ repo/src/app.js
const express = require('express');
const { importCsv, customers } = require('./importer');

const app = express();
app.use(express.json());
app.post('/import', async (req, res) => res.json(await importCsv(req.body.csv)));
app.get('/customers', async (req, res) => res.json(await customers.find({})));

module.exports = app;
@@@ repo/tests/import.test.js
const request = require('supertest');
const app = require('../src/app');

const imp = (csv) => request(app).post('/import').send({ csv });

describe('CSV import', () => {
  test('quoted commas stay in one field', async () => {
    await imp('name,email,amount\n"Shah, Ankit",ankit@x.com,500');
    const c = (await request(app).get('/customers')).body[0];
    expect(c.name).toBe('Shah, Ankit');
    expect(c.amount).toBe(500);
  });
  test('thousands separators', async () => {
    await imp('name,email,amount\nMeena,meena@x.com,"1,200"');
    expect((await request(app).get('/customers')).body[0].amount).toBe(1200);
  });
  test('error line numbers match the file', async () => {
    const res = await imp('name,email,amount\nOk,ok@x.com,10\nBad,not-an-email,10');
    expect(res.body.errors).toEqual([{ line: 3, reason: 'name and a valid email are required' }]);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const imp = (csv) => request(app).post('/import').send({ csv });

describe('hidden', () => {
  test('blank lines ignored, trailing newline ok', async () => {
    const res = await imp('name,email,amount\nA,a@x.com,1\n\nB,b@x.com,2\n');
    expect(res.body).toEqual({ imported: 2, skipped: 0, errors: [] });
  });
  test('duplicate emails are skipped (case-insensitive)', async () => {
    const res = await imp('name,email,amount\nA,a@x.com,1\nA2,A@X.com,2');
    expect(res.body).toMatchObject({ imported: 1, skipped: 1 });
  });
  test('escaped quotes', async () => {
    await imp('name,email,amount\n"The ""Boss""",boss@x.com,1');
    expect((await request(app).get('/customers')).body[0].name).toBe('The "Boss"');
  });
  test('"12abc" is not a number', async () => {
    const res = await imp('name,email,amount\nA,a@x.com,12abc');
    expect(res.body.errors).toEqual([{ line: 2, reason: 'amount is not a number' }]);
  });
});
@@@ solution/src/csv.js
function parseLine(line) {
  const out = [];
  let cur = '';
  let inQuotes = false;
  for (let i = 0; i < line.length; i++) {
    const c = line[i];
    if (inQuotes) {
      if (c === '"' && line[i + 1] === '"') { cur += '"'; i++; }
      else if (c === '"') inQuotes = false;
      else cur += c;
    } else if (c === '"') inQuotes = true;
    else if (c === ',') { out.push(cur.trim()); cur = ''; }
    else cur += c;
  }
  out.push(cur.trim());
  return out;
}

module.exports = { parseLine };
@@@ solution/src/importer.js
const db = require('memdb');
const { parseLine } = require('./csv');

const customers = db.collection('customers');

async function importCsv(text) {
  const [header, ...rows] = String(text).replace(/\r/g, '').split('\n');
  const result = { imported: 0, skipped: 0, errors: [] };
  const seen = new Set();

  for (let i = 0; i < rows.length; i++) {
    if (!rows[i].trim()) continue;
    const line = i + 2;
    const [name, email, rawAmount] = parseLine(rows[i]);
    if (!name || !email || !email.includes('@')) {
      result.errors.push({ line, reason: 'name and a valid email are required' });
      continue;
    }
    const amount = Number(String(rawAmount || '').replace(/,/g, ''));
    if (rawAmount === undefined || rawAmount === '' || !Number.isFinite(amount)) {
      result.errors.push({ line, reason: 'amount is not a number' });
      continue;
    }
    const key = email.toLowerCase();
    if (seen.has(key) || (await customers.findOne({ email: key }))) { result.skipped++; continue; }
    seen.add(key);
    await customers.insert({ name, email: key, amount });
    result.imported++;
  }
  return result;
}

module.exports = { importCsv, customers };
