@@@ repo/src/services/catalogService.js
const products = require('../data/products');

const DEFAULT_LIMIT = 3;

function sortProducts(items, sort) {
  if (sort === 'price_asc') {
    return items.sort((a, b) => a.price > b.price);
  }
  if (sort === 'price_desc') {
    return items.sort((a, b) => a.price < b.price);
  }
  return items;
}

function listProducts({ page, limit, sort, category }) {
  page = page || 1;
  limit = limit || DEFAULT_LIMIT;

  let items = category ? products.filter((p) => p.category === category) : products;
  items = sortProducts(items, sort);

  const total = items.length;
  const skip = page * limit;
  const data = items.slice(skip, skip + limit);

  return { data, page: Number(page), limit: Number(limit), total };
}

module.exports = { listProducts };
@@@ repo/tests/catalog.test.js
const request = require('supertest');
const app = require('../src/app');

const ids = (res) => res.body.data.map((p) => p.id);

describe('GET /products', () => {
  test('defaults to page 1 with 3 items', async () => {
    const res = await request(app).get('/products');
    expect(res.status).toBe(200);
    expect(ids(res)).toEqual(['p1', 'p2', 'p3']);
    expect(res.body.total).toBe(7);
  });

  test('page=2&limit=2 returns the 3rd and 4th products', async () => {
    const res = await request(app).get('/products?page=2&limit=2');
    expect(ids(res)).toEqual(['p3', 'p4']);
    expect(res.body.page).toBe(2);
    expect(res.body.limit).toBe(2);
  });

  test('sort=price_asc puts the cheapest first', async () => {
    const res = await request(app).get('/products?sort=price_asc&limit=4');
    expect(ids(res)).toEqual(['p3', 'p6', 'p7', 'p5']);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const ids = (res) => res.body.data.map((p) => p.id);

describe('hidden', () => {
  test('price_desc puts the most expensive first', async () => {
    const res = await request(app).get('/products?sort=price_desc&limit=2');
    expect(ids(res)).toEqual(['p1', 'p2']);
  });

  test('sorting does not change the default order for later requests', async () => {
    await request(app).get('/products?sort=price_asc');
    const res = await request(app).get('/products');
    expect(ids(res)).toEqual(['p1', 'p2', 'p3']);
  });

  test('category + sort + total', async () => {
    const res = await request(app).get('/products?category=books&sort=price_asc');
    expect(ids(res)).toEqual(['p3', 'p5']);
    expect(res.body.total).toBe(2);
  });

  test('last partial page', async () => {
    const res = await request(app).get('/products?page=2&limit=5');
    expect(ids(res)).toEqual(['p6', 'p7']);
  });

  test('page past the end is empty but total is still correct', async () => {
    const res = await request(app).get('/products?page=9');
    expect(res.body.data).toEqual([]);
    expect(res.body.total).toBe(7);
  });
});
@@@ solution/src/services/catalogService.js
const products = require('../data/products');

const DEFAULT_LIMIT = 3;

function sortProducts(items, sort) {
  if (sort === 'price_asc') {
    return [...items].sort((a, b) => a.price - b.price);
  }
  if (sort === 'price_desc') {
    return [...items].sort((a, b) => b.price - a.price);
  }
  return items;
}

function listProducts({ page, limit, sort, category }) {
  page = Number(page) || 1;
  limit = Number(limit) || DEFAULT_LIMIT;

  let items = category ? products.filter((p) => p.category === category) : products;
  items = sortProducts(items, sort);

  const total = items.length;
  const skip = (page - 1) * limit;
  const data = items.slice(skip, skip + limit);

  return { data, page, limit, total };
}

module.exports = { listProducts };
