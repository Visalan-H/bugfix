@@@ ticket.md
# EVT-3: RSVP counts are off

| Method | Path | Behaviour |
|---|---|---|
| `GET` | `/events/:id` | `{ id, capacity, attendees, spotsLeft }` |
| `POST` | `/events/:id/rsvp` | **201**. Full → **409**. Already attending → **409** |
| `DELETE` | `/events/:id/rsvp` | **204**. Not attending → **404** |

Header `x-user-id`. Seeded: `ev-meetup` (capacity 3), `ev-workshop` (capacity 1).
@@@ repo/package.json
{ "name": "rsvp", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/app.js
const express = require('express');
const svc = require('./rsvpService');

const app = express();
app.use(express.json());

app.get('/events/:id', async (req, res) => res.json(await svc.get(req.params.id)));
app.post('/events/:id/rsvp', async (req, res) => {
  await svc.join(req.params.id, req.get('x-user-id'));
  res.status(201).json(await svc.get(req.params.id));
});
app.delete('/events/:id/rsvp', async (req, res) => {
  await svc.leave(req.params.id, req.get('x-user-id'));
  res.status(204).end();
});
app.use((err, req, res, next) => res.status(err.status || 500).json({ error: err.message }));

module.exports = app;
@@@ repo/src/rsvpService.js
const db = require('memdb');
const events = db.collection('events');

const ready = Promise.all([
  events.insert({ _id: 'ev-meetup', capacity: 3, attendees: [] }),
  events.insert({ _id: 'ev-workshop', capacity: 1, attendees: [] }),
]);

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }
const NotFoundError = (m) => new HttpError(404, m);
const ConflictError = (m) => new HttpError(409, m);

async function load(id) {
  await ready;
  const ev = await events.findById(id);
  if (!ev) throw NotFoundError('event not found');
  return ev;
}

async function get(id) {
  const ev = await load(id);
  return { id: ev._id, capacity: ev.capacity, attendees: ev.attendees, spotsLeft: ev.capacity - ev.attendees.length };
}

async function join(id, userId) {
  const ev = await load(id);
  if (ev.attendees.length > ev.capacity) throw ConflictError('event is full');
  ev.attendees.push(userId);
  await events.updateById(id, { attendees: ev.attendees });
}

async function leave(id, userId) {
  const ev = await load(id);
  ev.attendees.splice(ev.attendees.indexOf(userId), 1);
  await events.updateById(id, { attendees: ev.attendees });
}

module.exports = { get, join, leave };
@@@ repo/tests/rsvp.test.js
const request = require('supertest');
const app = require('../src/app');

const rsvp = (ev, u) => request(app).post(`/events/${ev}/rsvp`).set('x-user-id', u);
const cancel = (ev, u) => request(app).delete(`/events/${ev}/rsvp`).set('x-user-id', u);
const get = (ev) => request(app).get(`/events/${ev}`);

describe('RSVP', () => {
  test('4th person on a capacity-3 event → 409', async () => {
    for (const u of ['a', 'b', 'c']) expect((await rsvp('ev-meetup', u)).status).toBe(201);
    expect((await rsvp('ev-meetup', 'd')).status).toBe(409);
    expect((await get('ev-meetup')).body.spotsLeft).toBe(0);
  });

  test('same user twice → 409', async () => {
    await rsvp('ev-meetup', 'a');
    expect((await rsvp('ev-meetup', 'a')).status).toBe(409);
    expect((await get('ev-meetup')).body.attendees).toEqual(['a']);
  });

  test('cancelling without an RSVP → 404 and nobody is removed', async () => {
    await rsvp('ev-meetup', 'alice');
    const res = await cancel('ev-meetup', 'bob');
    expect(res.status).toBe(404);
    expect((await get('ev-meetup')).body.attendees).toEqual(['alice']);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const rsvp = (ev, u) => request(app).post(`/events/${ev}/rsvp`).set('x-user-id', u);
const cancel = (ev, u) => request(app).delete(`/events/${ev}/rsvp`).set('x-user-id', u);

describe('hidden', () => {
  test('capacity 1 event', async () => {
    expect((await rsvp('ev-workshop', 'a')).status).toBe(201);
    expect((await rsvp('ev-workshop', 'b')).status).toBe(409);
  });
  test('cancel frees a spot', async () => {
    await rsvp('ev-workshop', 'a');
    expect((await cancel('ev-workshop', 'a')).status).toBe(204);
    expect((await rsvp('ev-workshop', 'b')).status).toBe(201);
  });
  test('unknown event → 404', async () => {
    expect((await rsvp('ev-nope', 'a')).status).toBe(404);
  });
  test('cancel removes the right person', async () => {
    for (const u of ['a', 'b', 'c']) await rsvp('ev-meetup', u);
    await cancel('ev-meetup', 'a');
    expect((await request(app).get('/events/ev-meetup')).body.attendees).toEqual(['b', 'c']);
  });
});
@@@ solution/src/rsvpService.js
const db = require('memdb');
const events = db.collection('events');

const ready = Promise.all([
  events.insert({ _id: 'ev-meetup', capacity: 3, attendees: [] }),
  events.insert({ _id: 'ev-workshop', capacity: 1, attendees: [] }),
]);

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }
const NotFoundError = (m) => new HttpError(404, m);
const ConflictError = (m) => new HttpError(409, m);

async function load(id) {
  await ready;
  const ev = await events.findById(id);
  if (!ev) throw NotFoundError('event not found');
  return ev;
}

async function get(id) {
  const ev = await load(id);
  return { id: ev._id, capacity: ev.capacity, attendees: ev.attendees, spotsLeft: ev.capacity - ev.attendees.length };
}

async function join(id, userId) {
  const ev = await load(id);
  if (ev.attendees.includes(userId)) throw ConflictError('already attending');
  if (ev.attendees.length >= ev.capacity) throw ConflictError('event is full');
  ev.attendees.push(userId);
  await events.updateById(id, { attendees: ev.attendees });
}

async function leave(id, userId) {
  const ev = await load(id);
  const i = ev.attendees.indexOf(userId);
  if (i === -1) throw NotFoundError('not attending');
  ev.attendees.splice(i, 1);
  await events.updateById(id, { attendees: ev.attendees });
}

module.exports = { get, join, leave };
