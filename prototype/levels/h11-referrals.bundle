@@@ repo/src/referrals.js
const db = require('memdb');

const users = db.collection('users');
const referrers = db.collection('referrers');
const CAP = 3;
const ready = referrers.insert({ _id: 'RAVI100', rewards: 2, balance: 200 });

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }

async function signup(email, referralCode) {
  await ready;
  let referredBy = null;

  if (referralCode) {
    const ref = await referrers.findById(referralCode);
    if (!ref) throw new HttpError(400, 'invalid referral code');
    if (ref.rewards < CAP) {
      await referrers.findOneAndUpdate({ _id: ref._id }, { $inc: { rewards: 1, balance: 100 } });
    }
    referredBy = ref._id;
  }

  const key = String(email || '').toLowerCase();
  if (!key.includes('@')) throw new HttpError(400, 'valid email required');
  if (await users.findOne({ email: key })) throw new HttpError(409, 'email already registered');
  await users.insert({ email: key, referredBy });
  return { email: key, referredBy };
}

async function referrer(code) {
  await ready;
  const r = await referrers.findById(String(code).toUpperCase());
  if (!r) throw new HttpError(404, 'not found');
  return { rewards: r.rewards, balance: r.balance };
}

module.exports = { signup, referrer };
@@@ repo/src/app.js
const express = require('express');
const svc = require('./referrals');

const app = express();
app.use(express.json());
app.post('/signup', async (req, res) => res.status(201).json(await svc.signup(req.body.email, req.body.referralCode)));
app.get('/referrers/:code', async (req, res) => res.json(await svc.referrer(req.params.code)));
app.use((err, req, res, next) => res.status(err.status || 500).json({ error: err.message }));

module.exports = app;
@@@ repo/tests/referrals.test.js
const request = require('supertest');
const app = require('../src/app');

const signup = (email, referralCode) => request(app).post('/signup').send({ email, referralCode });
const ravi = async () => (await request(app).get('/referrers/RAVI100')).body;

describe('Referrals', () => {
  test('cap holds under concurrent signups', async () => {
    const rs = await Promise.all(['a', 'b', 'c', 'd'].map((n) => signup(`${n}@x.com`, 'RAVI100')));
    expect(rs.every((r) => r.status === 201)).toBe(true);
    expect(await ravi()).toEqual({ rewards: 3, balance: 300 });
  });
  test('duplicate signup → 409 and no reward', async () => {
    await signup('dup@x.com');
    expect((await signup('DUP@x.com', 'RAVI100')).status).toBe(409);
    expect((await ravi()).rewards).toBe(2);
  });
  test('code is case-insensitive', async () => {
    const res = await signup('new@x.com', ' ravi100 ');
    expect(res.body.referredBy).toBe('RAVI100');
    expect((await ravi()).rewards).toBe(3);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const signup = (email, referralCode) => request(app).post('/signup').send({ email, referralCode });

describe('hidden', () => {
  test('unknown code is ignored', async () => {
    const res = await signup('z@x.com', 'NOPE');
    expect(res.status).toBe(201);
    expect(res.body.referredBy).toBe(null);
  });
  test('after the cap, signups still work and are still attributed', async () => {
    await signup('a@x.com', 'RAVI100');
    const res = await signup('b@x.com', 'RAVI100');
    expect(res.status).toBe(201);
    expect(res.body.referredBy).toBe('RAVI100');
    expect((await request(app).get('/referrers/RAVI100')).body.rewards).toBe(3);
  });
  test('bad email → 400 and no reward', async () => {
    expect((await signup('nope', 'RAVI100')).status).toBe(400);
    expect((await request(app).get('/referrers/RAVI100')).body.rewards).toBe(2);
  });
});
@@@ solution/src/referrals.js
const db = require('memdb');

const users = db.collection('users');
const referrers = db.collection('referrers');
const CAP = 3;
const ready = referrers.insert({ _id: 'RAVI100', rewards: 2, balance: 200 });

class HttpError extends Error { constructor(status, m) { super(m); this.status = status; } }

async function signup(email, referralCode) {
  await ready;
  const key = String(email || '').trim().toLowerCase();
  if (!key.includes('@')) throw new HttpError(400, 'valid email required');
  if (await users.findOne({ email: key })) throw new HttpError(409, 'email already registered');

  let referredBy = null;
  if (referralCode) {
    const code = String(referralCode).trim().toUpperCase();
    if (await referrers.findById(code)) referredBy = code;
  }

  await users.insert({ email: key, referredBy });

  if (referredBy) {
    await referrers.findOneAndUpdate({ _id: referredBy, rewards: { $lt: CAP } }, { $inc: { rewards: 1, balance: 100 } });
  }
  return { email: key, referredBy };
}

async function referrer(code) {
  await ready;
  const r = await referrers.findById(String(code).toUpperCase());
  if (!r) throw new HttpError(404, 'not found');
  return { rewards: r.rewards, balance: r.balance };
}

module.exports = { signup, referrer };
