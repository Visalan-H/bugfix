@@@ ticket.md
# SHIP-55: Customers overcharged for delivery

`POST /shipping/quote { weightKg, zone, orderTotal }` → `{ fee }`

* Base fee: `local` ₹40 · `regional` ₹60 · `national` ₹90. Unknown zone → **400**
* + ₹20 per **started** kg above 1 kg (1.2 kg → 1 extra kg, 2.2 kg → 2)
* Orders of **₹499 or more** ship free
* `weightKg` must be > 0 → else **400**
@@@ repo/package.json
{ "name": "shipping", "version": "1.0.0", "scripts": { "test": "jest" } }
@@@ repo/src/app.js
const express = require('express');
const { quote } = require('./fees');

const app = express();
app.use(express.json());

app.post('/shipping/quote', (req, res) => {
  try {
    res.json({ fee: quote(req.body) });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});

module.exports = app;
@@@ repo/src/fees.js
const FREE_FROM = 499;
const PER_EXTRA_KG = 20;

function baseFee(zone) {
  let fee;
  switch (zone) {
    case 'local':
      fee = 40;
    case 'regional':
      fee = 60;
      break;
    case 'national':
      fee = 90;
      break;
    default:
      throw new Error(`unknown zone: ${zone}`);
  }
  return fee;
}

function quote({ weightKg, zone, orderTotal }) {
  if (!(weightKg > 0)) throw new Error('weightKg must be > 0');
  const base = baseFee(zone);
  if (orderTotal > FREE_FROM) return 0;
  const extraKg = Math.round(Math.max(0, weightKg - 1));
  return base + extraKg * PER_EXTRA_KG;
}

module.exports = { quote };
@@@ repo/tests/fees.test.js
const request = require('supertest');
const app = require('../src/app');

const quote = (body) => request(app).post('/shipping/quote').send(body);

describe('Shipping', () => {
  test('local, light parcel', async () => {
    expect((await quote({ weightKg: 0.5, zone: 'local', orderTotal: 100 })).body.fee).toBe(40);
  });
  test('national, 2.2 kg → 2 extra kg', async () => {
    expect((await quote({ weightKg: 2.2, zone: 'national', orderTotal: 100 })).body.fee).toBe(130);
  });
  test('exactly ₹499 ships free', async () => {
    expect((await quote({ weightKg: 1, zone: 'regional', orderTotal: 499 })).body.fee).toBe(0);
  });
});
