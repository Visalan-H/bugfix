const service = require('../services/ticketService');

exports.list = async (req, res) => {
  const tickets = await service.listTickets({ status: req.query.status });
  res.json(tickets);
};

exports.create = async (req, res) => {
  const ticket = await service.createTicket(req.user, req.body);
  res.status(201).json(ticket);
};

exports.get = async (req, res) => {
  const ticket = await service.getTicket(req.params.id);
  res.json(ticket);
};

exports.addReply = async (req, res) => {
  const reply = await service.addReply(req.params.id, req.user, req.body.body);
  res.status(201).json(reply);
};

exports.close = async (req, res) => {
  const ticket = await service.closeTicket(req.params.id, req.user);
  res.json(ticket);
};
@@@ repo/src/services/ticketService.js
const repo = require('../repositories/ticketRepo');
const { ValidationError, NotFoundError, ForbiddenError, ConflictError } = require('../errors');

async function listTickets({ status }) {
  const tickets = await repo.findTickets(status ? { status } : {});
  return tickets.map(async (t) => ({ ...t, replyCount: await repo.countReplies(t._id) }));
}

async function createTicket(user, { title, description }) {
  if (!title || !title.trim()) throw new ValidationError('title is required');
  return repo.insertTicket({ title: title.trim(), description: description || '', authorId: user.id, status: 'open' });
}

async function getTicket(id) {
  const ticket = await repo.findTicketById(id);
  if (!ticket) throw new NotFoundError('Ticket');
  const replies = await repo.findReplies(id);
  return { ...ticket, replies };
}

async function addReply(ticketId, user, body) {
  if (!body || !body.trim()) throw new ValidationError('reply body is required');
  const ticket = await repo.findTicketById(ticketId);
  if (!ticket) throw new NotFoundError('Ticket');
  if (ticket.status === 'CLOSED') throw new ConflictError('ticket is closed');
  return repo.insertReply({ ticketId, authorId: user.id, body: body.trim() });
}

async function closeTicket(id, user) {
  const ticket = await repo.findTicketById(id);
  if (!ticket) throw new NotFoundError('Ticket');
  if (ticket.authorId !== user.id || user.role !== 'agent') {
    throw new ForbiddenError('only the author or an agent can close this ticket');
  }
  return repo.updateTicket(id, { status: 'closed' });
}

module.exports = { listTickets, createTicket, getTicket, addReply, closeTicket };
@@@ repo/src/repositories/ticketRepo.js
const db = require('memdb');
const tickets = db.collection('tickets');
const replies = db.collection('replies');

let seq = 0;

exports.findTickets = (filter) => tickets.find(filter);
exports.findTicketById = (id) => tickets.findById(id);
exports.insertTicket = (doc) => tickets.insert(doc);
exports.updateTicket = (id, patch) => tickets.updateById(id, patch);

exports.insertReply = (doc) => replies.insert({ ...doc, seq: ++seq });
exports.countReplies = (ticketId) => replies.count({ ticketId });
exports.findReplies = async (ticketId) => {
  const rows = await replies.find({ ticketId });
  return rows.sort((a, b) => a.seq - b.seq);
};
@@@ repo/tests/tickets.test.js
const request = require('supertest');
const app = require('../src/app');

const as = (id, role = 'customer') => ({
  get: (u) => request(app).get(u).set('x-user-id', id).set('x-role', role),
  post: (u, b = {}) => request(app).post(u).set('x-user-id', id).set('x-role', role).send(b),
});
const cust = as('c1');
const agent = as('a1', 'agent');

async function newTicket() {
  const r = await cust.post('/tickets', { title: 'Order not delivered', description: 'Order #123' });
  return r.body._id;
}

describe('Support desk', () => {
  test('unknown ticket is 404', async () => {
    const res = await cust.get('/tickets/does-not-exist');
    expect(res.status).toBe(404);
  });

  test('customer can reply to a ticket', async () => {
    const id = await newTicket();
    const res = await cust.post(`/tickets/${id}/replies`, { body: 'Any update?' });
    expect(res.status).toBe(201);
    const t = await cust.get(`/tickets/${id}`);
    expect(t.body.replies).toHaveLength(1);
    expect(t.body.replies[0].body).toBe('Any update?');
  });

  test('author can close their own ticket', async () => {
    const id = await newTicket();
    const res = await cust.post(`/tickets/${id}/close`);
    expect(res.status).toBe(200);
    expect(res.body.status).toBe('closed');
  });

  test('replying to a closed ticket is 409', async () => {
    const id = await newTicket();
    await agent.post(`/tickets/${id}/close`);
    const res = await cust.post(`/tickets/${id}/replies`, { body: 'hello?' });
    expect(res.status).toBe(409);
  });

  test('GET /tickets includes replyCount', async () => {
    const id = await newTicket();
    await agent.post(`/tickets/${id}/replies`, { body: 'Looking into it' });
    const res = await cust.get('/tickets');
    expect(res.body).toHaveLength(1);
    expect(res.body[0].title).toBe('Order not delivered');
    expect(res.body[0].replyCount).toBe(1);
  });
});
@@@ hidden.test.js
const request = require('supertest');
const app = require('../src/app');

const as = (id, role = 'customer') => ({
  get: (u) => request(app).get(u).set('x-user-id', id).set('x-role', role),
  post: (u, b = {}) => request(app).post(u).set('x-user-id', id).set('x-role', role).send(b),
});
const cust = as('c1');
const stranger = as('c2');
const agent = as('a1', 'agent');

async function newTicket() {
  const r = await cust.post('/tickets', { title: 'Refund', description: '' });
  return r.body._id;
}

describe('hidden', () => {
  test('a stranger cannot close someone else\'s ticket (403)', async () => {
    const id = await newTicket();
    const res = await stranger.post(`/tickets/${id}/close`);
    expect(res.status).toBe(403);
  });

  test('an agent can close any ticket', async () => {
    const id = await newTicket();
    const res = await agent.post(`/tickets/${id}/close`);
    expect(res.status).toBe(200);
  });

  test('empty reply is 400', async () => {
    const id = await newTicket();
    const res = await cust.post(`/tickets/${id}/replies`, { body: '   ' });
    expect(res.status).toBe(400);
  });

  test('replies come back oldest first', async () => {
    const id = await newTicket();
    await cust.post(`/tickets/${id}/replies`, { body: 'one' });
    await agent.post(`/tickets/${id}/replies`, { body: 'two' });
    await cust.post(`/tickets/${id}/replies`, { body: 'three' });
    const t = await cust.get(`/tickets/${id}`);
    expect(t.body.replies.map((r) => r.body)).toEqual(['one', 'two', 'three']);
  });

  test('status filter', async () => {
    const a = await newTicket();
    await newTicket();
    await agent.post(`/tickets/${a}/close`);
    const res = await cust.get('/tickets?status=open');
    expect(res.body).toHaveLength(1);
    expect(res.body[0].replyCount).toBe(0);
  });

  test('missing x-user-id is 401', async () => {
    const res = await request(app).get('/tickets');
    expect(res.status).toBe(401);
  });
});
